{
  "compilerOptions": {
    "allowJs": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "jsx": "react",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2019",
    "typeRoots": ["./typings", "./node_modules/@types"],
    "types": ["node", "ffprobe", "ffprobe-installer__ffprobe", "css-modules"]
  },
  "files": [],
  "references": [
    { "path": "./packages/core" },
    { "path": "./packages/core/__tests__" },
    { "path": "./packages/exams" },
    { "path": "./packages/generator" },
    { "path": "./packages/generator/__tests__" },
    { "path": "./packages/mastering" },
    { "path": "./packages/mastering/__tests__" },
    { "path": "./packages/rendering" },
    { "path": "./packages/rendering/__tests__" },
    { "path": "./packages/cli" }
  ]
}
