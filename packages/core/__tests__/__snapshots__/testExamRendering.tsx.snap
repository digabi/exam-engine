          >
            <div
              className="anchor"
              id="question-nr-20"
            />
            
      
            <h3
              className="exam-question-title"
              id="question-title-20"
            >
              <strong
                className="exam-question-title__display-number"
              >
                20. 
              </strong>
              attachment-link
               
              <span
                className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
              >
                0 p.
              </span>
            </h3>
            
      
            <div
              className="exam-question-instruction e-mrg-b-2"
              id="question-instruction-187"
            >
              
        Material on external material page can be linked to from exam page by using
        
              <code>
                e:attachment-link
              </code>
              
        element.
      
            </div>
            

      
            <table
              className="e-table e-width-full"
            >
              <caption>
                
          Element attributes
        
              </caption>
              <thead>
                <tr>
                  <th>
                    Attribute
                  </th>
                  <th>
                    Type
                  </th>
                  <th>
                    Mandatory
                  </th>
                  <th>
                    Default value
                  </th>
                  <th>
                    Description
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>
                    ref
                  </td>
                  <td>
                    String
                  </td>
                  <td>
                    Yes
                  </td>
                  <td>
                    –
                  </td>
                  <td>
                    
              Value of the linked
              
                    <code>
                      e:attachment
                    </code>
                    
              's
              
                    <code>
                      name
                    </code>
                    
              attribute.
            
                  </td>
                </tr>
                <tr>
                  <td>
                    type
                  </td>
                  <td>
                    
              
                    <code>
                      long | short
                    </code>
                    
            
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    
              
                    <code>
                      long
                    </code>
                    
            
                  </td>
                  <td>
                    Type of the reference, see example below.
                  </td>
                </tr>
                <tr>
                  <td>
                    meta
                  </td>
                  <td>
                    String
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    –
                  </td>
                  <td>
                    Metadata about element
                  </td>
                </tr>
              </tbody>
            </table>
            

      
            <h4>
              Example
            </h4>
            
      
            <pre
              className="code"
            >
              &lt;e:attachment-link ref="test-material" /&gt;
&lt;e:attachment-link ref="another-test-material" type="short" /&gt;
            </pre>
            
      
            <div
              className="example"
            >
              
        
              <code>
                long
              </code>
              
        type reference:
        
              (
              <a
                className="attachment-link e-nowrap"
                href="/attachments#13.A"
                target="attachments"
              >
                aineisto
                 
                13.A
              </a>
              )
              
        
              <br />
              
        
              <code>
                short
              </code>
              
        type reference:
        
              <a
                className="attachment-link e-nowrap"
                href="/attachments#13.B"
                target="attachments"
              >
                13.B
              </a>
              
      
            </div>
            

    
          </div>
          

    
          <div
            className="e-exam-question e-level-0 e-pad-b-8 e-clearfix"
