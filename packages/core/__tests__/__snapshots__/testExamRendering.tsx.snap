        <div
          className="e-exam-question e-level-0 e-mrg-b-8 e-clearfix"
          id="11"
        >
          
      
          <h3
            className="exam-question-title"
          >
            <strong
              className="exam-question-title__display-number"
            >
              11. 
            </strong>
            
        dnd-answer
      
             
          </h3>
          
      
          <div
            className="exam-question-instruction e-mrg-b-2"
            id="question-instruction-179"
          >
            
        
            <p>
              
          
              <code>
                e:dnd-answer
              </code>
              
          is a 
              <code>
                connect
              </code>
               type of drag-and-drop element. 
          The correct answer is defined by placing a question in the 
              <code>
                e:dnd-answer-title
              </code>
               element and the correct answer option in the 
              <code>
                e:dnd-answer-option
              </code>
               within the 
              <code>
                e:dnd-answer
              </code>
               element. 
          
              <code>
                e:dnd-answer
              </code>
               elements are placed within the 
              <code>
                e:dnd-answer-container
              </code>
               element.
          Wrong answers are defined by placing 
              <code>
                e:dnd-answer-option
              </code>
               elements within the 
              <code>
                e:dnd-answer-container
              </code>
               element. 
          
              <code>
                e:dnd-answer-title
              </code>
               and 
              <code>
                e:dnd-answer-option
              </code>
               can contain text, images, formulas and audio.
          
              <br />
              <br />
              <code>
                e:dnd-answer
              </code>
               is automatically graded based on a set of correct answers
        
            </p>
            
      
          </div>
          

      
          <table
            className="e-table e-width-full"
          >
            <caption>
              
      Element attributes (
      
              <code>
                e:dnd-answer-container
              </code>
              
      )
    
            </caption>
            <thead>
              <tr>
                <th>
                  Attribute
                </th>
                <th>
                  Type
                </th>
                <th>
                  Mandatory
                </th>
                <th>
                  Default value
                </th>
                <th>
                  Description
                </th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  dnd-type
                </td>
                <td>
                  <code>
                    connect
                  </code>
                </td>
                <td>
                  Yes
                </td>
                <td>
                  connect
                </td>
                <td>
                  Drag-and-Drop type
                </td>
              </tr>
            </tbody>
          </table>
          

    
          <table
            className="e-table e-width-full"
          >
            <caption>
              
      Element attributes (
      
              <code>
                e:dnd-answer
              </code>
              
      )
    
            </caption>
            <thead>
              <tr>
                <th>
                  Attribute
                </th>
                <th>
                  Type
                </th>
                <th>
                  Mandatory
                </th>
                <th>
                  Default value
                </th>
                <th>
                  Description
                </th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  max-score
                </td>
                <td>
                  Integer
                </td>
                <td>
                  Yes
                </td>
                <td>
                  3
                </td>
                <td>
                  Maximum score
                </td>
              </tr>
            </tbody>
          </table>
          

    
          <table
            className="e-table e-width-full"
          >
            <caption>
              
      Element attributes (
      
              <code>
                e:dnd-answer-option
              </code>
              
      )
    
            </caption>
            <thead>
              <tr>
                <th>
                  Attribute
                </th>
                <th>
                  Type
                </th>
                <th>
                  Mandatory
                </th>
                <th>
                  Default value
                </th>
                <th>
                  Description
                </th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  score
                </td>
                <td>
                  Integer
                </td>
                <td>
                  Yes
                </td>
                <td>
                  3
                </td>
                <td>
                  Answer score
                </td>
              </tr>
            </tbody>
          </table>
          

      
          <h4>
            
        Example of
        
            <code>
              e:dnd-answer
            </code>
            
      
          </h4>
          
      
          <pre
            className="code"
          >
            &lt;e:question&gt;
          &lt;e:question-title&gt;&lt;/e:question-title&gt;
          &lt;e:question-instruction&gt;&lt;/e:question-instruction&gt;
          &lt;e:audio-group&gt;
            &lt;e:attachment&gt;
              &lt;e:attachment-title&gt;example audio&lt;/e:attachment-title&gt;
              &lt;e:audio src="example1.webm" times="1"&gt;&lt;e:audio-title&gt;Listen to the text as a whole first.&lt;/e:audio-title&gt;&lt;/e:audio&gt;
            &lt;/e:attachment&gt;
          &lt;/e:audio-group&gt;
          &lt;e:dnd-answer-container meta='dnd answer container' dnd-type='connect'&gt;
              &lt;e:dnd-answer max-score="2"&gt;
                  &lt;e:dnd-answer-title&gt;
                    What time suits Lars best?
                    &lt;e:audio src="example1.webm" times="1"&gt;&lt;/e:audio&gt;
                  &lt;/e:dnd-answer-title&gt;
                  &lt;e:dnd-answer-option score="2"&gt;Monday, 3:00 PM&lt;/e:dnd-answer-option&gt;
              &lt;/e:dnd-answer&gt;
              &lt;e:dnd-answer max-score="2"&gt;
                  &lt;e:dnd-answer-title&gt;
                    What time suits Katarina best?
                    &lt;e:audio src="example1.webm" times="1"&gt;&lt;/e:audio&gt;
                  &lt;/e:dnd-answer-title&gt;
                  &lt;e:dnd-answer-option score="2"&gt;Tuesday, 1:00 p.m.&lt;/e:dnd-answer-option&gt;
              &lt;/e:dnd-answer&gt;
              &lt;e:dnd-answer max-score="2"&gt;
                  &lt;e:dnd-answer-title&gt;
                    What time suits Marit best?
                    &lt;e:audio src="example1.webm" times="1"&gt;&lt;/e:audio&gt;
                  &lt;/e:dnd-answer-title&gt;
                  &lt;e:dnd-answer-option score="2"&gt;Monday, 4:00 PM&lt;/e:dnd-answer-option&gt;
              &lt;/e:dnd-answer&gt;
              &lt;e:dnd-answer-option&gt;Monday, 1:00 PM&lt;/e:dnd-answer-option&gt;
              &lt;e:dnd-answer-option&gt;Monday, 2:00 pm&lt;/e:dnd-answer-option&gt;
              &lt;e:dnd-answer-option&gt;Tuesday, 2:00 pm&lt;/e:dnd-answer-option&gt;
              &lt;e:dnd-answer-option&gt;Tuesday, 3:00 pm&lt;/e:dnd-answer-option&gt;
              &lt;e:dnd-answer-option&gt;Tuesday, 4:00 pm&lt;/e:dnd-answer-option&gt;
          &lt;/e:dnd-answer-container&gt;
      &lt;/e:question&gt;
          </pre>
          

          
