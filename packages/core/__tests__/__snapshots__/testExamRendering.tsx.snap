            </div>
            

      
            <pre
              className="code"
            >
              &lt;ol class="e-list-lower-roman"&gt;
  &lt;li&gt;Eka&lt;/li&gt;
  &lt;li&gt;Toka&lt;/li&gt;
  &lt;li&gt;Kolmas&lt;/li&gt;
&lt;/ol&gt;
            </pre>
            
      
            <div
              className="example"
            >
              
        
              <ol
                className="e-list-lower-roman"
              >
                
          
                <li>
                  First
                </li>
                
          
                <li>
                  Second
                </li>
                
          
                <li>
                  Third
                </li>
                
        
              </ol>
              
      
            </div>
            

      
            <pre
              className="code"
            >
              &lt;ol class="e-list-upper-roman"&gt;
  &lt;li&gt;Eka&lt;/li&gt;
  &lt;li&gt;Toka&lt;/li&gt;
  &lt;li&gt;Kolmas&lt;/li&gt;
&lt;/ol&gt;
            </pre>
            
      
            <div
              className="example"
            >
              
        
              <ol
                className="e-list-upper-roman"
              >
                
          
                <li>
                  First
                </li>
                
          
