          <p>
            
        Notice that certain characters in formulas require special notation.
      
          </p>
          
      
          <table
            className="e-table"
          >
            <caption />
            <thead>
              <tr>
                <th>
                  Character
                </th>
                <th>
                  Notation
                </th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
