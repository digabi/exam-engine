              </div>
              
      
            </div>
            
      
            <div
              className="e-exam-question e-mrg-l-8 e-mrg-y-4"
              data-annotation-anchor="1.1"
              data-toc-id="question-1.1"
            >
              <div
                className="anchor"
                id="question-nr-1.1"
              />
              
        
              <h4
                className="exam-question-title e-normal e-font-size-m"
                id="question-title-1.1"
              >
                <strong
                  className="exam-question-title__display-number exam-question-title__display-number--indented"
                >
                  1.1 
                </strong>
                Special characters as entities
                 
                <span
                  className="e-score e-nowrap e-score--small e-font-size-m e-semibold"
                >
                  0 p.
                </span>
              </h4>
              
        
              <div
                className="exam-question-instruction e-mrg-b-2"
                id="question-instruction-168"
              >
                
          
                <p>
                  Certain characters requires escaping as entities in exam XML documents
                </p>
                
          
                <table
                  className="e-table"
                >
                  <caption />
                  <thead>
                    <tr>
                      <th>
                        Character
                      </th>
                      <th>
                        Notation
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td>
                        NBSP (non-breaking-space)
                      </td>
                      <td>
                        <code>
                          &#xA0;
                        </code>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        SHY ­ (soft-hyphen)
                      </td>
                      <td>
                        <code>
                          &#173;
                        </code>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        &gt;
                      </td>
                      <td>
                        <code>
                          &gt;
                        </code>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        &lt;
                      </td>
                      <td>
                        <code>
                          &lt;
                        </code>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        &
                      </td>
                      <td>
                        <code>
                          &amp;
                        </code>
                      </td>
                    </tr>
                  </tbody>
                </table>
                
          
                <p>
                  Notice, that e.g. 
                  <code>
                    &nbsp;
                  </code>
                   and 
                  <code>
                    &shy;
                  </code>
                   does not work.
                </p>
                
        
              </div>
              
      
            </div>
            
    
          </div>
          

    
          <div
            className="e-exam-question e-level-0 e-pad-b-8 e-clearfix"
            data-annotation-anchor="2"
            data-toc-id="question-2"
          >
            <div
              className="anchor"
              id="question-nr-2"
            />
            
      
            <h3
              className="exam-question-title"
              id="question-title-2"
            >
              <strong
                className="exam-question-title__display-number"
              >
                2. 
              </strong>
              Exam
               
              <span
                className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
              >
                0 p.
              </span>
            </h3>
            
      
            <div
              className="exam-question-instruction e-mrg-b-2"
              id="question-instruction-169"
            >
              
        
              <p>
                
          Top-level exam element.
        
              </p>
              
      
            </div>
            
      
            <table
              className="e-table e-width-full"
            >
              <caption>
                Element attributes
              </caption>
              <thead>
                <tr>
                  <th>
                    Attribute
                  </th>
                  <th>
                    Type
                  </th>
                  <th>
                    Mandatory
                  </th>
                  <th>
                    Default value
                  </th>
                  <th>
                    Description
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>
                    exam-schema-version
                  </td>
                  <td>
                    Version string
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    —
                  </td>
                  <td>
                    Schema version, only 0.1 for now
                  </td>
                </tr>
                <tr>
                  <td>
                    date
                  </td>
                  <td>
                    YYYY-MM-DD
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    —
                  </td>
                  <td>
                    Exam date
                  </td>
                </tr>
                <tr>
                  <td>
                    exam-code
                  </td>
                  <td>
                    exam code string
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    —
                  </td>
                  <td>
                    Exam code used for exam specific translations
                  </td>
                </tr>
                <tr>
                  <td>
                    day-code
                  </td>
                  <td>
                    exam day code string
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    —
                  </td>
                  <td>
                    Exam day code used for exam specific translations
                  </td>
                </tr>
                <tr>
                  <td>
                    exam-stylesheet
                  </td>
                  <td>
                    custom CSS stylesheet file name
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    —
                  </td>
                  <td>
                    CSS file with this name must exist in attachments directory
                  </td>
                </tr>
                <tr>
                  <td>
                    max-answers
                  </td>
                  <td>
                    Integer
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    No limit
                  </td>
                  <td>
                    Maximum number of questions student should answer
                  </td>
                </tr>
                <tr>
                  <td>
                    meta
                  </td>
                  <td>
                    String
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    –
                  </td>
                  <td>
                    Metadata about element
                  </td>
                </tr>
              </tbody>
            </table>
            
      
            <p>
              
        
              <code>
                exam-code
              </code>
              
        and
        
              <code>
                day-code
              </code>
              
        attributes control exam-specific
        translations, e.g. the heading text of table of contents, and the exam title if specific
        
              <code>
                e:exam-title
              </code>
              
        element is missing. Currently supported exam and day
        code pairs can be found in
        
              <a
                href="https://github.com/digabi/exam-engine/blob/master/packages/mastering/src/i18n/exam_titles_fi-FI.json"
              >
                https://github.com/digabi/exam-engine/blob/master/packages/mastering/src/i18n/exam_titles_fi-FI.json
              </a>
              
        .
      
            </p>
            
      
            <div
              className="warning-box"
            >
              
        max-answers is ignored in Abitti grading.
      
            </div>
            
      
            <div
              className="e-exam-question e-mrg-l-8 e-mrg-y-4"
              data-annotation-anchor="2.1"
              data-toc-id="question-2.1"
            >
              <div
                className="anchor"
                id="question-nr-2.1"
              />
              
        
              <h4
                className="exam-question-title e-normal e-font-size-m"
                id="question-title-2.1"
              >
                <strong
                  className="exam-question-title__display-number exam-question-title__display-number--indented"
                >
                  2.1 
                </strong>
                Example
                 
                <span
                  className="e-score e-nowrap e-score--small e-font-size-m e-semibold"
                >
                  0 p.
                </span>
              </h4>
              
        
              <h4 />
              
        
              <pre
                className="code"
              >
                &lt;e:exam
  xmlns:e="http://ylioppilastutkinto.fi/exam.xsd"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://www.w3.org/1999/xhtml"
  xsi:schemaLocation="http://ylioppilastutkinto.fi/exam.xsd https://abitti.net/schema/exam.xsd"
  exam-schema-version="0.1"
  date="2018-09-29"
  exam-code="EA"
  exam-stylesheet="custom.css"&gt;
              </pre>
              
      
            </div>
            
    
          </div>
          

    
          <div
            className="e-exam-question e-level-0 e-pad-b-8 e-clearfix"
            data-annotation-anchor="3"
            data-toc-id="question-3"
          >
            <div
              className="anchor"
              id="question-nr-3"
            />
            
      
            <h3
              className="exam-question-title"
              id="question-title-3"
            >
              <strong
                className="exam-question-title__display-number"
              >
                3. 
              </strong>
              Languages and localization
               
              <span
                className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
              >
                0 p.
              </span>
            </h3>
            
      
            <div
              className="exam-question-instruction e-mrg-b-2"
              id="question-instruction-170"
            >
              
        
              <p>
                
          Content for multiple language versions of the same exam can be defined using localization elements.
        
              </p>
              
        
              <div
                className="warning-box"
              >
                
          Multiple languages work in Abitti when you create transfer zip with "npm run create-transfer-zip" -command. It generates separate transfer zip for each language.
        
              </div>
              
      
            </div>
            
      
            <div
              className="e-exam-question e-mrg-l-8 e-mrg-y-4"
              data-annotation-anchor="3.1"
              data-toc-id="question-3.1"
            >
              <div
                className="anchor"
                id="question-nr-3.1"
              />
              
        
              <h4
                className="exam-question-title e-normal e-font-size-m"
                id="question-title-3.1"
              >
                <strong
                  className="exam-question-title__display-number exam-question-title__display-number--indented"
                >
                  3.1 
                </strong>
                Example
                 
                <span
                  className="e-score e-nowrap e-score--small e-font-size-m e-semibold"
                >
                  0 p.
                </span>
              </h4>
              
        
              <h4 />
              
        
              <pre
                className="code"
              >
                &lt;e:languages&gt;
  &lt;e:language&gt;fi-FI&lt;/e:language&gt;
  &lt;e:language&gt;sv-FI&lt;/e:language&gt;
&lt;/e:languages&gt;
...
&lt;e:localization lang="fi-FI"&gt;
  &lt;p&gt;
    Älä jätä mitään merkintöjä sellaisen tehtävän vastaukselle varattuun tilaan,
    jota et halua jättää arvosteltavaksi.
  &lt;/p&gt;
&lt;/e:localization&gt;
&lt;e:localization lang="sv-FI"&gt;
  &lt;p&gt;
    Lämna inga anteckningar i svarsfältet för sådana uppgifter som du inte vill
    lämna in för bedömning.
  &lt;/p&gt;
&lt;/e:localization&gt;
              </pre>
              
        
              <span
                lang="fi-FI"
              >
                
          
                <p>
                  
            Älä jätä mitään merkintöjä sellaisen tehtävän vastaukselle varattuun tilaan,
            jota et halua jättää arvosteltavaksi.
          
                </p>
                
        
              </span>
              
        
      
            </div>
            

      
            <div
              className="e-exam-question e-mrg-l-8 e-mrg-y-4"
              data-annotation-anchor="3.2"
              data-toc-id="question-3.2"
            >
              <div
                className="anchor"
                id="question-nr-3.2"
              />
              
        
              <h4
                className="exam-question-title e-normal e-font-size-m"
                id="question-title-3.2"
              >
                <strong
                  className="exam-question-title__display-number exam-question-title__display-number--indented"
                >
                  3.2 
                </strong>
                Pre-defined translations
                 
                <span
                  className="e-score e-nowrap e-score--small e-font-size-m e-semibold"
                >
                  0 p.
                </span>
              </h4>
              
        
              <p>
                There are some pre-defined translations that can be easily reused with the 
                <code>
                  e:translation
                </code>
                 tag. For example this code
              </p>
              
        
              <pre
                className="code"
              >
                &lt;e:translation key="audio-test.instructions" /&gt;
              </pre>
              
        
              <p>
                renders the following text:
          
                Koe sisältää kuullunymmärtämisen tehtäviä.
                
        
              </p>
              
        
              <p>
                For a full list of available translations, 
                <a
                  href="https://github.com/digabi/exam-engine/tree/master/packages/core/src/i18n"
                >
                  see these files
                </a>
                .
        By default, each exam's translations are first looked up in their corresponding translation files (for example,
        German exam = GA.ts), and then in the generic Finnish/Swedish translation files (fi-FI.ts and sv-FI.ts)
              </p>
              
      
            </div>
            
    
          </div>
          


  
        </section>
        

  
        <section
          aria-labelledby="section-title-2"
          className="e-section e-bg-color-off-white e-pad-6 exam-section"
        >
          
    
          <h2
            className="exam-section-title"
            data-annotation-anchor="section-title-2"
            data-toc-id="section-2"
            id="section-title-2"
          >
            Osa 2:
             
            Sections
          </h2>
          <span
            className="notification notification--inline"
          >
            <svg
              aria-hidden="true"
              className="svg-inline--fa fa-circle-info e-color-link e-mrg-r-1 fa-fw fa-lg"
              data-icon="circle-info"
              data-prefix="fas"
              role="img"
              viewBox="0 0 512 512"
            >
              <path
                d="M256 512a256 256 0 1 0 0-512 256 256 0 1 0 0 512zM224 160a32 32 0 1 1 64 0 32 32 0 1 1 -64 0zm-8 64l48 0c13.3 0 24 10.7 24 24l0 88 8 0c13.3 0 24 10.7 24 24s-10.7 24-24 24l-80 0c-13.3 0-24-10.7-24-24s10.7-24 24-24l24 0 0-64-24 0c-13.3 0-24-10.7-24-24s10.7-24 24-24z"
                fill="currentColor"
              />
            </svg>
            Vastaa tehtävään 4.
          </span>
          
    
          <div
            className="e-mrg-b-2"
          >
            
      
            <p>
              
        Exam consists of sections. Each section is described in
        
              <code>
                e:section
              </code>
              
        element.
      
            </p>
            
      
            <p>
              
        Section can define how many questions should be answered using
        
              <code>
                max-answers
              </code>
              
        attribute.
      
            </p>
            
      
            <div
              className="warning-box"
            >
              
        max-answers is ignored in Abitti grading.
      
            </div>
            
      
            <p>
              
        Section attribute 
              <code>
                type
              </code>
               can be user to describe how an exam should be packed.
      
            </p>
            
      
            <div
              className="warning-box"
            >
              
        Type attribute is an YTL specific type code that is used only in packaging exams for matriculation examination. Type options are H, T, D, E, X, A and B. Use 'H' to denote hearing section of the exam. The other options have more cosmetic effect on exam packaging. This attribute does not have effect on how sections are displayed in the exam.
      
            </div>
            
      
            <p>
              
        CAS applications can be disabled for a
        section by setting
        
              <code>
                cas-forbidden="true"
              </code>
              
        attribute.
      
            </p>
            
      
            <p>
              
        Metadata can be added with
        
              <code>
                meta
              </code>
              
        attribute.
      
            </p>
            
    
          </div>
          
    
          <div
            className="e-mrg-b-2"
          >
            
      
            <h4>
              Example of simple section
            </h4>
            
      
            <pre
              className="code"
            >
              &lt;e:section max-answers="1"&gt;
  &lt;e:section-title&gt;Example section title&lt;/e:section-title&gt;
  &lt;e:section-instruction&gt;Section instructions&lt;/e:section-instruction&gt;
  ...HTML code, questions...
  &lt;e:question&gt;
    &lt;e:question-title&gt;Example question title&lt;/e:question-title&gt;
    &lt;e:question-instruction&gt;Question instructions&lt;/e:question-instruction&gt;
    …HTML code, answer types, materials, sub-questions...
  &lt;/e:question&gt;
&lt;/e:section&gt;
            </pre>
            
    
          </div>
          
    
          <div
            className="e-exam-question e-level-0 e-pad-b-8 e-clearfix"
            data-annotation-anchor="4"
            data-toc-id="question-4"
          >
            <div
              className="anchor"
              id="question-nr-4"
            />
            
      
            <h3
              className="exam-question-title"
              id="question-title-4"
            >
              <strong
                className="exam-question-title__display-number"
              >
                4. 
              </strong>
              Example question title
               
              <span
                className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
              >
                0 p.
              </span>
            </h3>
            
      
            <div
              className="exam-question-instruction e-mrg-b-2"
              id="question-instruction-171"
            >
              Question instructions
            </div>
            
      …HTML code, answer types, materials, sub-questions...
    
          </div>
          
  
        </section>
        

  
        <section
          aria-labelledby="section-title-3"
          className="e-section e-bg-color-off-white e-pad-6 exam-section"
        >
          
    
          <h2
            className="exam-section-title"
            data-annotation-anchor="section-title-3"
            data-toc-id="section-3"
            id="section-title-3"
          >
            Osa 3:
             
            Questions
          </h2>
          
    
          <div
            className="e-mrg-b-2"
          >
            
      
            <p>
              
        Every section consists of questions defined using
        
              <code>
                e:question
              </code>
              
        elements.
        Questions are numbered automatically and they can contain HTML code, answer types,
        material or sub-questions. Question can define how many sub-questions should be answered
        using
        
              <code>
                max-answers
              </code>
              
        attribute.
      
            </p>
            
      
            <p>
              
        Maximum score of question is calculated automatically using the answer types, optional
        sub-questions and the limits from
        
              <code>
                max-answers
              </code>
              
        attributes.
      
            </p>
            
      
            <div
              className="warning-box"
            >
              
          max-answers is ignored in Abitti grading.
        
            </div>
            
      
            <p>
              
        Metadata can be added with
        
              <code>
                meta
              </code>
              
        attribute.
      
            </p>
            
    
          </div>
          

    
          <div
            className="e-mrg-b-2"
          >
            
      
            <h4>
              Simple question example
            </h4>
            
      
            <pre
              className="code"
            >
              &lt;e:question&gt;
  &lt;e:question-title&gt;Example question title&lt;/e:question-title&gt;
  &lt;e:question-instruction&gt;Question description&lt;/e:question-instruction&gt;
  …HTML code, answer types, materials, sub-questions, question numbers (e.g. &lt;e:question-number suffix="1" /&gt;)...
&lt;/e:question&gt;
            </pre>
            
    
          </div>
          
    
          <div
            className="e-exam-question e-level-0 e-pad-b-8 e-clearfix"
            data-annotation-anchor="5"
            data-toc-id="question-5"
          >
            <div
              className="anchor"
              id="question-nr-5"
            />
            
      
            <h3
              className="exam-question-title"
              id="question-title-5"
            >
              <strong
                className="exam-question-title__display-number"
              >
                5. 
              </strong>
              Example question title
               
              <span
                className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
              >
                0 p.
              </span>
            </h3>
            
      
            <div
              className="exam-question-instruction e-mrg-b-2"
              id="question-instruction-172"
            >
              Question description
            </div>
            
      …HTML code, answer types, materials, sub-questions, question numbers (e.g. 
            5
            .
            1
            )...
    
          </div>
          

    
          <div
            className="e-mrg-b-2"
          >
            
      
            <h4>
              Sub-question example
            </h4>
            
      
            <pre
              className="code"
            >
              &lt;e:question max-answers="1"&gt;
  &lt;e:question-title&gt;Second example question title&lt;/e:question-title&gt;
  &lt;e:question-instruction&gt;Second example question instructions&lt;/e:question-instruction&gt;
  &lt;e:question&gt;
    &lt;e:question-title&gt;First sub-question title&lt;/e:question-title&gt;
    &lt;e:question-instruction&gt;First sub-question instructions&lt;/e:question-instruction&gt;
    …HTML code, answer types, materials, sub-questions...
  &lt;/e:question&gt;
  &lt;e:question&gt;
    &lt;e:question-title&gt;Second sub-question title&lt;/e:question-title&gt;
    &lt;e:question-instruction&gt;Second sub-question instructions&lt;/e:question-instruction&gt;
    …HTML code, answer types, materials, sub-questions...
  &lt;/e:question&gt;
&lt;/e:question&gt;
            </pre>
            
    
          </div>
          
    
          <div
            className="e-exam-question e-level-0 e-pad-b-8 e-clearfix"
            data-annotation-anchor="6"
            data-toc-id="question-6"
          >
            <div
              className="anchor"
              id="question-nr-6"
            />
            
      
            <h3
              className="exam-question-title"
              id="question-title-6"
            >
              <strong
                className="exam-question-title__display-number"
              >
                6. 
              </strong>
              Second example question title
               
              <span
                className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
              >
                0 p.
              </span>
            </h3>
            <p
              className="e-italic"
            >
              <svg
                aria-hidden="true"
                className="svg-inline--fa fa-circle-info e-color-link e-mrg-r-1 fa-fw fa-lg"
                data-icon="circle-info"
                data-prefix="fas"
                role="img"
                viewBox="0 0 512 512"
              >
                <path
                  d="M256 512a256 256 0 1 0 0-512 256 256 0 1 0 0 512zM224 160a32 32 0 1 1 64 0 32 32 0 1 1 -64 0zm-8 64l48 0c13.3 0 24 10.7 24 24l0 88 8 0c13.3 0 24 10.7 24 24s-10.7 24-24 24l-80 0c-13.3 0-24-10.7-24-24s10.7-24 24-24l24 0 0-64-24 0c-13.3 0-24-10.7-24-24s10.7-24 24-24z"
                  fill="currentColor"
                />
              </svg>
              Vastaa joko kohtaan 6.1 tai 6.2.
            </p>
            
      
            <div
              className="exam-question-instruction e-mrg-b-2"
              id="question-instruction-173"
            >
              Second example question instructions
            </div>
            
      
            <div
              className="e-exam-question e-mrg-l-8 e-mrg-y-4"
              data-annotation-anchor="6.1"
              data-toc-id="question-6.1"
            >
              <div
                className="anchor"
                id="question-nr-6.1"
              />
              
        
              <h4
                className="exam-question-title e-normal e-font-size-m"
                id="question-title-6.1"
              >
                <strong
                  className="exam-question-title__display-number exam-question-title__display-number--indented"
                >
                  6.1 
                </strong>
                First sub-question title
                 
                <span
                  className="e-score e-nowrap e-score--small e-font-size-m e-semibold"
                >
                  0 p.
                </span>
              </h4>
              
        
              <div
                className="exam-question-instruction e-mrg-b-2"
                id="question-instruction-174"
              >
                First sub-question instructions
              </div>
              
        …HTML code, answer types, materials, sub-questions...
      
            </div>
            
      
            <div
              className="e-exam-question e-mrg-l-8 e-mrg-y-4"
              data-annotation-anchor="6.2"
              data-toc-id="question-6.2"
            >
              <div
                className="anchor"
                id="question-nr-6.2"
              />
              
        
              <h4
                className="exam-question-title e-normal e-font-size-m"
                id="question-title-6.2"
              >
                <strong
                  className="exam-question-title__display-number exam-question-title__display-number--indented"
                >
                  6.2 
                </strong>
                Second sub-question title
                 
                <span
                  className="e-score e-nowrap e-score--small e-font-size-m e-semibold"
                >
                  0 p.
                </span>
              </h4>
              
        
              <div
                className="exam-question-instruction e-mrg-b-2"
                id="question-instruction-175"
              >
                Second sub-question instructions
              </div>
              
        …HTML code, answer types, materials, sub-questions...
      
            </div>
            
    
          </div>
          
  
        </section>
        

  
        <section
          aria-labelledby="section-title-4"
          className="e-section e-bg-color-off-white e-pad-6 exam-section"
        >
          
    
          <h2
            className="exam-section-title"
            data-annotation-anchor="section-title-4"
            data-toc-id="section-4"
            id="section-title-4"
          >
            Osa 4:
             
            Answer types
          </h2>
          
    
          <div
            className="e-exam-question e-level-0 e-pad-b-8 e-clearfix"
            data-annotation-anchor="7"
            data-toc-id="question-7"
          >
            <div
              className="anchor"
              id="question-nr-7"
            />
            
      
            <h3
              className="exam-question-title"
              id="question-title-7"
            >
              <strong
                className="exam-question-title__display-number"
              >
                7. 
              </strong>
              text-answer
               
              <span
                className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
              >
                7 p.
              </span>
            </h3>
            
      
            <p>
              
        There are three types of text answers.
        
              <code>
                rich-text
              </code>
              
        answer is intended for verbose essay-style answers, whereas
        
              <code>
                single-line
              </code>
              
        answer is intended for short, at most couple words, answers.
        
              <code>
                integer
              </code>
              
        answer is intended for integer answers.
      
            </p>
            

      
            <p>
              
        Examinee can also attach screenshots to
        
              <code>
                rich-text
              </code>
              
        answers.
      
            </p>
            

      
            <table
              className="e-table e-width-full"
            >
              <caption>
                Element attributes
              </caption>
              <thead>
                <tr>
                  <th>
                    Attribute
                  </th>
                  <th>
                    Type
                  </th>
                  <th>
                    Mandatory
                  </th>
                  <th>
                    Default value
                  </th>
                  <th>
                    Description
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>
                    max-score
                  </td>
                  <td>
                    Integer
                  </td>
                  <td>
                    Yes
                  </td>
                  <td>
                    —
                  </td>
                  <td>
                    Maximum score
                  </td>
                </tr>
                <tr>
                  <td>
                    max-length
                  </td>
                  <td>
                    Integer
                  </td>
                  <td>
                    Yes
                  </td>
                  <td>
                    —
                  </td>
                  <td>
                    Maximum answer length. Works only for 
                    <code>
                      rich-text
                    </code>
                     answers. It won't prevent student from entering an answer that is too long but warns the student about it.
                  </td>
                </tr>
                <tr>
                  <td
                    className="e-nowrap"
                  >
                    use-language-of-instruction
                  </td>
                  <td>
                    Boolean
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    false
                  </td>
                  <td>
                    Whether the student should answer the question in the language of instruction (typically the mother tongue) or the subject language. This attribute controls the HTML lang attribute of the input element, so a screen reader will read the answer using the correct language. Used only in secondary language exams.
                  </td>
                </tr>
                <tr>
                  <td>
                    type
                  </td>
                  <td>
                    
              
                    <code>
                      single-line | rich-text | integer
                    </code>
                    
            
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    
              
                    <code>
                      single-line
                    </code>
                    
            
                  </td>
                  <td>
                    Type
                  </td>
                </tr>
                <tr>
                  <td>
                    class
                  </td>
                  <td>
                    CSS class
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    -
                  </td>
                  <td>
                    CSS class name
                  </td>
                </tr>
                <tr>
                  <td>
                    meta
                  </td>
                  <td>
                    String
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    –
                  </td>
                  <td>
                    Metadata about element
                  </td>
                </tr>
              </tbody>
            </table>
            

      
            <h4>
              
        
              <code>
                single-line
              </code>
              
        answer example
      
            </h4>
            
      
            <pre
              className="code"
            >
              &lt;e:text-answer max-score="2" /&gt;
            </pre>
            
      
            <div
              className="example"
            >
              
        
              <span
                className="anchor"
                id="question-nr-7.1"
              />
              <span
                className="e-nowrap"
              >
                <input
                  aria-describedby="answer-score-196"
                  aria-labelledby="question-title-7"
                  className="text-answer text-answer--single-line"
                  data-question-id={1}
                  onBlur={[Function]}
                  onChange={[Function]}
                  onFocus={[Function]}
                  spellCheck="false"
                  type="text"
                />
                <sup
                  className="e-score e-nowrap e-score--inline e-font-size-xs"
                  id="answer-score-196"
                >
                  2 p.
                </sup>
              </span>
              
      
            </div>
            

      
            <h4>
              
        
              <code>
                rich-text
              </code>
              
        answer example
      
            </h4>
            
      
            <pre
              className="code"
            >
              &lt;e:text-answer type="rich-text" max-score="2" /&gt;
            </pre>
            
      
            <div
              className="example"
            >
              
        
              <span
                className="anchor"
                id="question-nr-7.2"
              />
              <div
                className="text-answer-container"
              >
                <div
                  className="rich-text-editor-toolbar-root"
                />
                <div
                  aria-invalid={false}
                  aria-labelledby="question-title-7"
                  aria-multiline={true}
                  className="sc-gvqKNf eTdHaO rich-text-editor answer text-answer text-answer--rich-text"
                  contentEditable={true}
                  data-question-id={2}
                  data-testid="rich-text-editor"
                  id="2"
                  onBlur={[Function]}
                  onDragOver={[Function]}
                  onDrop={[Function]}
                  onFocus={[Function]}
                  onInput={[Function]}
                  onKeyDown={[Function]}
                  onMouseDown={[Function]}
                  onPaste={[Function]}
                  role="textbox"
                  spellCheck={false}
                />
                <button
                  aria-labelledby="expand-label"
                  aria-owns="2"
                  className="expand open"
                  onClick={[Function]}
                >
                  <div
                    className="label"
                    id="expand-label"
                  >
                    Avaa kirjoitusnäkymä
                  </div>
                  <svg
                    aria-hidden="true"
                    className="svg-inline--fa fa-up-right-and-down-left-from-center"
                    data-icon="up-right-and-down-left-from-center"
                    data-prefix="fas"
                    role="img"
                    viewBox="0 0 512 512"
                  >
                    <path
                      d="M344 0L488 0c13.3 0 24 10.7 24 24l0 144c0 9.7-5.8 18.5-14.8 22.2s-19.3 1.7-26.2-5.2l-39-39-87 87c-9.4 9.4-24.6 9.4-33.9 0l-32-32c-9.4-9.4-9.4-24.6 0-33.9l87-87-39-39c-6.9-6.9-8.9-17.2-5.2-26.2S334.3 0 344 0zM168 512L24 512c-13.3 0-24-10.7-24-24L0 344c0-9.7 5.8-18.5 14.8-22.2S34.1 320.2 41 327l39 39 87-87c9.4-9.4 24.6-9.4 33.9 0l32 32c9.4 9.4 9.4 24.6 0 33.9l-87 87 39 39c6.9 6.9 8.9 17.2 5.2 26.2S177.7 512 168 512z"
                      fill="currentColor"
                    />
                  </svg>
                </button>
                <div
                  className="answer-toolbar e-font-size-xs e-columns e-mrg-b-2"
                >
                  <div
                    className="answer-toolbar__answer-length e-column"
                  >
                     
                  </div>
                  <div
                    className="answer-toolbar__history e-column e-column--narrow e-text-right"
                  />
                </div>
              </div>
              
      
            </div>
            

      
            <h4>
              
        
              <code>
                rich-text
              </code>
              
        answer with maximum length
      
            </h4>
            
      
            <pre
              className="code"
            >
              &lt;e:text-answer type="rich-text" max-score="2" max-length="20" /&gt;
            </pre>
            
      
            <div
              className="example"
            >
              
        
              <span
                className="anchor"
                id="question-nr-7.3"
              />
              <p
                className="e-answer-length-info"
                id="answer-length-info-198"
              >
                <svg
                  aria-hidden="true"
                  className="svg-inline--fa fa-circle-info e-color-link e-mrg-r-1 fa-fw fa-lg"
                  data-icon="circle-info"
                  data-prefix="fas"
                  role="img"
                  viewBox="0 0 512 512"
                >
                  <path
                    d="M256 512a256 256 0 1 0 0-512 256 256 0 1 0 0 512zM224 160a32 32 0 1 1 64 0 32 32 0 1 1 -64 0zm-8 64l48 0c13.3 0 24 10.7 24 24l0 88 8 0c13.3 0 24 10.7 24 24s-10.7 24-24 24l-80 0c-13.3 0-24-10.7-24-24s10.7-24 24-24l24 0 0-64-24 0c-13.3 0-24-10.7-24-24s10.7-24 24-24z"
                    fill="currentColor"
                  />
                </svg>
                <em>
                  Vastaus saa olla enintään 20 merkkiä pitkä. Ylityksestä seuraa pistevähennys.
                </em>
              </p>
              <div
                className="text-answer-container"
              >
                <div
                  className="rich-text-editor-toolbar-root"
                />
                <div
                  aria-invalid={false}
                  aria-labelledby="question-title-7 answer-length-info-198"
                  aria-multiline={true}
                  className="sc-gvqKNf eTdHaO rich-text-editor answer text-answer text-answer--rich-text"
                  contentEditable={true}
                  data-question-id={3}
                  data-testid="rich-text-editor"
                  id="3"
                  onBlur={[Function]}
                  onDragOver={[Function]}
                  onDrop={[Function]}
                  onFocus={[Function]}
                  onInput={[Function]}
                  onKeyDown={[Function]}
                  onMouseDown={[Function]}
                  onPaste={[Function]}
                  role="textbox"
                  spellCheck={false}
                />
                <button
                  aria-labelledby="expand-label"
                  aria-owns="3"
                  className="expand open"
                  onClick={[Function]}
                >
                  <div
                    className="label"
                    id="expand-label"
                  >
                    Avaa kirjoitusnäkymä
                  </div>
                  <svg
                    aria-hidden="true"
                    className="svg-inline--fa fa-up-right-and-down-left-from-center"
                    data-icon="up-right-and-down-left-from-center"
                    data-prefix="fas"
                    role="img"
                    viewBox="0 0 512 512"
                  >
                    <path
                      d="M344 0L488 0c13.3 0 24 10.7 24 24l0 144c0 9.7-5.8 18.5-14.8 22.2s-19.3 1.7-26.2-5.2l-39-39-87 87c-9.4 9.4-24.6 9.4-33.9 0l-32-32c-9.4-9.4-9.4-24.6 0-33.9l87-87-39-39c-6.9-6.9-8.9-17.2-5.2-26.2S334.3 0 344 0zM168 512L24 512c-13.3 0-24-10.7-24-24L0 344c0-9.7 5.8-18.5 14.8-22.2S34.1 320.2 41 327l39 39 87-87c9.4-9.4 24.6-9.4 33.9 0l32 32c9.4 9.4 9.4 24.6 0 33.9l-87 87 39 39c6.9 6.9 8.9 17.2 5.2 26.2S177.7 512 168 512z"
                      fill="currentColor"
