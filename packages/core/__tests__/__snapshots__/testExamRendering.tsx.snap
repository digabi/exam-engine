              <code>
                e:attachment-links
              </code>
              
        element to refere to multiple materials.
      
            </div>
            

      
            <h4>
              Example
            </h4>
            
      
            <pre
              className="code"
            >
              &lt;e:attachment-links&gt;
  &lt;e:attachment-link ref="test-material" /&gt;
  &lt;e:attachment-link ref="another-test-material" /&gt;
&lt;/e:attachment-links&gt;
&lt;e:attachment-links type="short"&gt;
  &lt;e:attachment-link ref="test-material" /&gt;
  &lt;e:attachment-link ref="another-test-material" /&gt;
&lt;/e:attachment-links&gt;
            </pre>
            
      
            <div
              className="example"
            >
              
        
              (
              <a
                className="attachment-link e-nowrap"
                href="/attachments#13.A"
                target="attachments"
              >
                aineistot
                 
                13.A–13.B
              </a>
              )
              
        
              <br />
              
        
              <a
                className="attachment-link e-nowrap"
                href="/attachments#13.A"
                target="attachments"
              >
                13.A–13.B
              </a>
              
      
            </div>
            
    
