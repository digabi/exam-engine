            </div>
            


      
            <h4>
              
        
              <code>
                integer
              </code>
              
        answer example
      
            </h4>
            
      
            <p>
              The answer can only contain digits (0...9), and optionally a minus sign (-) at the beginning
            </p>
            
      
            <pre
              className="code"
            >
              &lt;e:text-answer type="integer" max-score="1" /&gt;
            </pre>
            
      
            <div
              className="example"
            >
              
        
              <span
                className="anchor"
                id="question-nr-7.4"
              />
              <span
                className="e-nowrap"
              >
                <input
                  aria-describedby="answer-score-199"
                  aria-labelledby="question-title-7"
                  className="text-answer text-answer--single-line text-answer--integer"
                  data-question-id={4}
                  onBlur={[Function]}
                  onChange={[Function]}
                  onFocus={[Function]}
                  spellCheck="false"
                  type="text"
                  value=""
                />
                <sup
                  className="e-score e-nowrap e-score--inline e-font-size-xs"
                  id="answer-score-199"
                >
                  1 p.
                </sup>
              </span>
              
      
            </div>
            

    
          </div>
          

    
          <div
            className="e-exam-question e-level-0 e-pad-b-8 e-clearfix"
            data-annotation-anchor="8"
            data-toc-id="question-8"
          >
            <div
              className="anchor"
              id="question-nr-8"
            />
            
      
            <h3
              className="exam-question-title"
              id="question-title-8"
            >
              <strong
                className="exam-question-title__display-number"
              >
                8. 
              </strong>
              
        choice-answer
      
               
              <span
                className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
              >
                2 p.
              </span>
            </h3>
            
      
            <div
              className="exam-question-instruction e-mrg-b-2"
              id="question-instruction-176"
            >
              
        
              <p>
                
          
                <code>
                  e:choice-answer
                </code>
                
          answer type creates a group of option buttons. Answer options are defined within it
          using
          
                <code>
                  e:choice-answer-option
                </code>
                
          elements.
        
              </p>
              
        
              <p>
                By default options are shuffled.
              </p>
              
      
            </div>
            

      
            <table
              className="e-table e-width-full"
            >
              <caption>
                
          Element attributes (
          
                <code>
                  e:choice-answer
                </code>
                
          )
        
              </caption>
              <thead>
                <tr>
                  <th>
                    Attribute
                  </th>
                  <th>
                    Type
                  </th>
                  <th>
                    Mandatory
                  </th>
                  <th>
                    Default value
                  </th>
                  <th>
                    Description
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>
                    ordering
                  </td>
                  <td>
                    
              
                    <code>
                      random | fixed
                    </code>
                    
            
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    random
                  </td>
                  <td>
                    Ordering of options
                  </td>
                </tr>
                <tr>
                  <td>
                    direction
                  </td>
                  <td>
                    
              
                    <code>
                      vertical | horizontal
                    </code>
                    
            
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    vertical
                  </td>
                  <td>
                    Direction of options
                  </td>
                </tr>
                <tr>
                  <td>
                    class
                  </td>
                  <td>
                    CSS class
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    -
                  </td>
                  <td>
                    CSS class name
                  </td>
                </tr>
                <tr>
                  <td>
                    meta
                  </td>
                  <td>
                    String
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    –
                  </td>
                  <td>
                    Metadata about element
                  </td>
                </tr>
              </tbody>
            </table>
            

      
            <table
              className="e-table e-width-full"
            >
              <caption>
                
          Element attributes (
          
                <code>
                  e:choice-answer-option
                </code>
                
          )
        
              </caption>
              <thead>
                <tr>
                  <th>
                    Attribute
                  </th>
                  <th>
                    Type
                  </th>
                  <th>
                    Mandatory
                  </th>
                  <th>
                    Default value
                  </th>
                  <th>
                    Description
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>
                    score
                  </td>
                  <td>
                    Integer
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    0
                  </td>
                  <td>
                    Score for option
                  </td>
                </tr>
                <tr>
                  <td>
                    class
                  </td>
                  <td>
                    CSS class
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    -
                  </td>
                  <td>
                    CSS class name
                  </td>
                </tr>
                <tr>
                  <td>
                    meta
                  </td>
                  <td>
                    String
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    –
                  </td>
                  <td>
                    Metadata about element
                  </td>
                </tr>
              </tbody>
            </table>
            

      
            <h4>
              Examples
            </h4>
            
      
            <pre
              className="code"
            >
              &lt;e:choice-answer&gt;
  &lt;e:choice-answer-option score="2"&gt;Lorem&lt;/e:choice-answer-option&gt;
  &lt;e:choice-answer-option score="0"&gt;Ipsum&lt;/e:choice-answer-option&gt;
  &lt;e:choice-answer-option&gt;Dolor&lt;/e:choice-answer-option&gt;
  &lt;e:choice-answer-option score="-1"&gt;Sit&lt;/e:choice-answer-option&gt;
&lt;/e:choice-answer&gt;
            </pre>
            
      
            <div
              className="example"
            >
              
        
              <div
                aria-labelledby="question-instruction-176"
                className="e-choice-answer e-mrg-b-4"
                data-question-id={5}
                role="radiogroup"
              >
                <span
                  className="anchor"
                  id="question-nr-8.1"
                />
                <div
                  className="e-mrg-b-1"
                >
                  <label
                    className="e-columns e-columns--inline"
                  >
                    <input
                      checked={false}
