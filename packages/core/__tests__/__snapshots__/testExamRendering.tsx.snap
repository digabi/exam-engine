    <section
      aria-labelledby="section-title-4"
      className="e-section e-bg-color-off-white e-pad-6"
    >
      <div
        className="e-results-section-wrapper"
      >
        
    
        <h2
          className="exam-section-title"
          data-annotation-anchor="section-title-4"
          data-toc-id="section-4"
          id="section-title-4"
        >
          Osa 4:
           
          Answer types
        </h2>
        
    
        <div
          className="e-exam-question e-level-0 e-mrg-b-8 e-clearfix"
          id="7"
        >
          
      
          <h3
            className="exam-question-title"
          >
            <strong
              className="exam-question-title__display-number"
            >
              7. 
            </strong>
            text-answer
             
          </h3>
          
      
          <p>
            
        There are three types of text answers.
        
            <code>
              rich-text
            </code>
            
        answer is intended for verbose essay-style answers, whereas
        
            <code>
              single-line
            </code>
            
        answer is intended for short, at most couple words, answers.
        
            <code>
              integer
            </code>
            
        answer is intended for integer answers.
      
          </p>
          

      
          <p>
            
        Examinee can also attach screenshots to
        
            <code>
              rich-text
            </code>
            
        answers.
      
          </p>
          

      
          <table
            className="e-table e-width-full"
          >
            <caption>
              Element attributes
            </caption>
            <thead>
              <tr>
                <th>
                  Attribute
                </th>
                <th>
                  Type
                </th>
                <th>
                  Mandatory
                </th>
                <th>
                  Default value
                </th>
                <th>
                  Description
                </th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  max-score
                </td>
                <td>
                  Integer
                </td>
                <td>
                  Yes
                </td>
                <td>
                  —
                </td>
                <td>
                  Maximum score
                </td>
              </tr>
              <tr>
                <td>
                  max-length
                </td>
                <td>
                  Integer
                </td>
                <td>
                  Yes
                </td>
                <td>
                  —
                </td>
                <td>
                  Maximum answer length. Works only for 
                  <code>
                    rich-text
                  </code>
                   answers. It won't prevent student from entering an answer that is too long but warns the student about it.
                </td>
              </tr>
              <tr>
                <td
                  className="e-nowrap"
                >
                  use-language-of-instruction
                </td>
                <td>
                  Boolean
                </td>
                <td>
                  No
                </td>
                <td>
                  false
                </td>
                <td>
                  Whether the student should answer the question in the language of instruction (typically the mother tongue) or the subject language. This attribute controls the HTML lang attribute of the input element, so a screen reader will read the answer using the correct language. Used only in secondary language exams.
                </td>
              </tr>
              <tr>
                <td>
                  type
                </td>
                <td>
                  
              
                  <code>
                    single-line | rich-text | integer
                  </code>
                  
            
                </td>
                <td>
                  No
                </td>
                <td>
                  
              
                  <code>
                    single-line
                  </code>
                  
            
                </td>
                <td>
                  Type
                </td>
              </tr>
              <tr>
                <td>
                  class
                </td>
                <td>
                  CSS class
                </td>
                <td>
                  No
                </td>
                <td>
                  -
                </td>
                <td>
                  CSS class name
                </td>
              </tr>
              <tr>
                <td>
                  meta
                </td>
                <td>
                  String
                </td>
                <td>
                  No
                </td>
                <td>
                  –
                </td>
                <td>
                  Metadata about element
                </td>
              </tr>
            </tbody>
          </table>
          

      
          <h4>
            
        
            <code>
              single-line
            </code>
            
        answer example
      
          </h4>
          
      
          <pre
            className="code"
          >
            &lt;e:text-answer max-score="2" /&gt;
          </pre>
          
      
          <div
            className="example"
          >
            
        
            <sup>
              1.
            </sup>
            <span
              className="text-answer text-answer--single-line"
            >
              <span
                className="e-screen-reader-only"
              >
                [Vastaus alkaa]
              </span>
              <span
                className="e-inline-block"
              >
                Answer to question 7.1
              </span>
              <span
                className="e-screen-reader-only"
              >
                [Vastaus päättyy]
              </span>
            </span>
            <span
              className="e-result-scorecount e-float-right"
              id="7.1"
            >
              <span
                className="e-result-scorecount-border-wrap"
              >
                <sup
                  aria-hidden="true"
                  className="e-result-scorecount-sup e-mrg-r-1"
                >
                  1.
                </sup>
                <div
                  className="e-color-black"
                >
                  <span
                    className="e-mrg-r-1 e-nowrap e-nowrap e-font-size-m"
                  >
                    <b>
                      0
                    </b>
                     / 2
                     p.
                  </span>
                  <span
                    className="e-mrg-r-1 e-nowrap e-result-scorecount-shortcode"
                  >
                    TestIns1, TestIns2
                  </span>
                  <span
                    className="e-mrg-r-1 e-nowrap e-mrg-r-0"
                  >
                    ov
                  </span>
                </div>
                <div
                  className="e-color-darkgrey e-font-size-xs"
                >
                  <span
                    className="e-mrg-r-1 e-nowrap e-nowrap"
                  >
                    0
                     p.
                  </span>
                  <span
                    className="e-mrg-r-1 e-nowrap e-result-scorecount-shortcode"
                  >
                    TestCen1
