                      fill="currentColor"
                    />
                  </svg>
                </button>
                <div
                  className="answer-toolbar e-font-size-xs e-columns e-mrg-b-2"
                >
                  <div
                    className="answer-toolbar__answer-length e-column"
                  >
                     
                  </div>
                  <div
                    className="answer-toolbar__history e-column e-column--narrow e-text-right"
                  />
                </div>
              </div>
              
      
            </div>
            
    
          </div>
          
  
          <p>
            <em>
              Kokeen tehtävät loppuvat tähän.
            </em>
          </p>
        </section>
        

        <div
          className="e-exam-footer"
        >
          <p
            className="e-text-center e-semibold"
            lang="fi-FI"
          >
            Tarkista, että vastasit ohjeiden mukaiseen määrään tehtäviä. Älä jätä mitään merkintöjä sellaisen tehtävän vastaukselle varattuun tilaan, jota et halua jättää arvosteltavaksi.
          </p>
        </div>
        <div
          className="e-examine-exam"
        >
          <button
            aria-describedby="examineExamInstructions"
            className="e-button goto-examine-answers"
            onClick={[Function]}
          >
            Siirry tarkastelemaan vastauksiasi
          </button>
          <div
            className="e-examine-exam-instructions"
            id="examineExamInstructions"
          >
            Tarkastelun jälkeen voit vielä palata muokkaamaan vastauksia, tai päättää kokeen.
          </div>
        </div>
      </div>
    </div>
  </div>
  <footer
    className="e-footer"
  >
    <div
      className="e-footer-version-number-container"
    >
      <span>
        EE v.
        1.0.0
      </span>
    </div>
  </footer>
  <div
    className="e-indicators-container"
  />
</main>
`;

