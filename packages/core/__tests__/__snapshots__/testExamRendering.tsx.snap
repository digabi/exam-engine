              <tr>
                <td>
                  Volymen av en pyramid är alltså 
                  <span
                    aria-hidden="true"
                    className="e-formula"
                    dangerouslySetInnerHTML={
                      {
                        "__html": "<svg xmlns:xlink="http://www.w3.org/1999/xlink" width="16.474ex" height="4.565ex" style="vertical-align: -1.671ex;" viewBox="0 -1245.8 7092.8 1965.4" role="img" focusable="false" xmlns="http://www.w3.org/2000/svg" aria-labelledby="MathJax-SVG-1-Title">
