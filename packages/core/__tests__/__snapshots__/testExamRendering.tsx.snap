                id="question-title-1.3"
              >
                <strong
                  className="exam-question-title__display-number exam-question-title__display-number--indented"
                >
                  1.3 
                </strong>
                
          
          
                <span
                  lang="sv-FI"
                >
                  
            Regn
          
                </span>
                
        
                 
                <span
                  className="e-score e-nowrap e-score--small e-font-size-m e-semibold"
                >
                  2 p.
                </span>
              </h4>
              
        
        
              <span
                lang="sv-FI"
              >
                
          
                <div
                  aria-labelledby="question-title-1.3"
                  className="e-choice-answer e-mrg-b-4"
                  data-question-id={6}
                  role="radiogroup"
                >
                  <span
                    className="anchor"
                    id="question-nr-1.3"
                  />
                  <div
                    className="e-mrg-b-1"
                  >
                    <label
                      className="e-columns e-columns--inline"
                    >
                      <input
                        checked={false}
                        className="e-radio-button e-column e-column--narrow"
                        name="6"
                        onChange={[Function]}
                        type="radio"
                        value="57"
                      />
                      <div
                        className="e-choice-answer-option e-column e-pointer"
                      >
                        Konvektionsregn uppstår när solen intensivt värmer jordens yta vilket gör att en luftmassa stiger och fukt kondenseras till regn.
                      </div>
                    </label>
                  </div>
                  <div
                    className="e-mrg-b-1"
                  >
                    <label
                      className="e-columns e-columns--inline"
                    >
                      <input
                        checked={false}
                        className="e-radio-button e-column e-column--narrow"
                        name="6"
                        onChange={[Function]}
                        type="radio"
                        value="58"
                      />
                      <div
                        className="e-choice-answer-option e-column e-pointer"
                      >
                        Orografiskt regn uppstår när en fuktig luftmassa är tvungen att stiga på grund av en kust eller en bergskedja, vilket gör att luftmassan kyls ner och fukt kondenseras till regn.
                      </div>
                    </label>
                  </div>
                  <div
                    className="e-mrg-b-1"
                  >
                    <label
                      className="e-columns e-columns--inline"
                    >
                      <input
                        checked={false}
                        className="e-radio-button e-column e-column--narrow"
                        name="6"
                        onChange={[Function]}
                        type="radio"
                        value="59"
                      />
                      <div
                        className="e-choice-answer-option e-column e-pointer"
                      >
                        Konvektionsregn är vanligast i de kalla områdena på jorden och i Finland vintertid.
                      </div>
