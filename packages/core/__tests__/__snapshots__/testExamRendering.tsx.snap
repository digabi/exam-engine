        <div
          aria-description="Tähän kysymykseen ei ole vastattu"
          className="e-exam-question e-level-0 e-mrg-b-8 e-clearfix no-answer"
          id="25"
        >
          
      
          <h3
            className="exam-question-title"
          >
            <strong
              className="exam-question-title__display-number"
            >
              25. 
            </strong>
            Floating
             
          </h3>
          

      
          <table
            className="e-table e-width-full"
          >
            <thead>
              <tr>
                <th>
                  Class
                </th>
                <th>
                  Description
                </th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  
              
                  <code>
                    e-float-left
                  </code>
                  
            
                </td>
                <td>
                  
              Floats element to the
              
                  <strong>
                    left
                  </strong>
                  
            
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-float-right
                  </code>
                  
            
                </td>
                <td>
                  
              Floats element to the
              
                  <strong>
                    right
                  </strong>
                  
            
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-clearfix
                  </code>
                  
            
                </td>
                <td>
                  Stops floating
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-width-full
                  </code>
                  
            
                </td>
                <td>
                  
              Sets element width to
              
                  <strong>
                    100%
                  </strong>
                  
            
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-width-threequarters
                  </code>
                  
            
                </td>
                <td>
                  
              Sets element width to
              
                  <strong>
                    75%
                  </strong>
                  
            
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-width-half
                  </code>
                  
            
                </td>
                <td>
                  
              Sets element width to
              
                  <strong>
                    50%
                  </strong>
                  
            
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-width-third
                  </code>
                  
            
                </td>
                <td>
                  
              Sets element width to
              
                  <strong>
                    33%
                  </strong>
                  
            
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-width-quarter
                  </code>
                  
            
                </td>
                <td>
                  
              Sets element width to
              
                  <strong>
                    25%
                  </strong>
                  
            
                </td>
              </tr>
            </tbody>
          </table>
          

      
          <h3>
            Example
          </h3>
          
      
          <pre
            className="code"
          >
            &lt;div class="e-clearfix"&gt;
  &lt;e:image src="example.jpg" class="e-width-half e-mrg-r-2 e-float-left" /&gt;
  &lt;p&gt;Lorem ipsum dolor sit amet.&lt;/p&gt;
&lt;/div&gt;
&lt;div class="e-clearfix"&gt;
  &lt;e:image src="example.jpg" class="e-width-third e-mrg-l-2 e-float-right" /&gt;
  &lt;p&gt;Lorem ipsum dolor sit amet.&lt;/p&gt;
&lt;/div&gt;
          </pre>
          
      
          <div
            className="example"
          >
            
        
            <div
              className="e-clearfix"
            >
              
          
              
          
              <p>
                Lorem ipsum dolor sit amet.
              </p>
              
        
            </div>
            
        
            <div
              className="e-clearfix"
            >
              
          
              
          
              <p>
                Lorem ipsum dolor sit amet.
              </p>
              
        
            </div>
            
      
          </div>
          

    
        </div>
        

    
        <div
          aria-description="Tähän kysymykseen ei ole vastattu"
          className="e-exam-question e-level-0 e-mrg-b-8 e-clearfix no-answer"
          id="26"
        >
          
      
          <h3
            className="exam-question-title"
          >
            <strong
              className="exam-question-title__display-number"
            >
              26. 
            </strong>
            Illustration images
             
          </h3>
          
      
          <div
            className="exam-question-instruction e-mrg-b-2"
            id="question-instruction-191"
          >
            
        For images aligned to the right there is a helper class
        
            <code>
              e-illustration-right
            </code>
            
        .
        In addition to right alignment, it adds proper margins. The class does not restrict
        image size, therefore
        
            <code>
              e-width-*
            </code>
            
        classes can be used simultaneously.
      
          </div>
          

      
          <h3>
            Example
          </h3>
          
      
          <pre
            className="code"
          >
            &lt;e:image src="example.jpg" class="e-illustration-right e-width-third" /&gt;
&lt;p&gt;
  Lorem ipsum dolor sit amet consectetur adipisicing elit. Quos
  dolores quam facere vel cum eos enim eaque soluta? Ullam doloribus
  explicabo commodi numquam suscipit iste recusandae illum laboriosam
  dolorum ducimus?
&lt;/p&gt;
&lt;p&gt;
  Lorem ipsum dolor sit amet consectetur adipisicing elit. Ea
  officiis adipisci odit neque quam corporis voluptatibus iste
  veritatis libero tempora eius nihil facilis tempore, sit sunt enim
  exercitationem. Suscipit, fugit?
&lt;/p&gt;
&lt;p&gt;
  Lorem ipsum dolor sit amet consectetur adipisicing elit. Sed rerum
  necessitatibus vero illo porro voluptatum fuga et quibusdam
  voluptates adipisci veniam, quas natus exercitationem atque
  voluptas tempora accusamus voluptate culpa!
&lt;/p&gt;
          </pre>
          
      
          <div
            className="example e-clearfix"
          >
            
        
            
        
            <p>
              
          Lorem ipsum dolor sit amet consectetur adipisicing elit. Quos
          dolores quam facere vel cum eos enim eaque soluta? Ullam doloribus
          explicabo commodi numquam suscipit iste recusandae illum laboriosam
          dolorum ducimus?
        
            </p>
            
        
            <p>
              
          Lorem ipsum dolor sit amet consectetur adipisicing elit. Ea
          officiis adipisci odit neque quam corporis voluptatibus iste
          veritatis libero tempora eius nihil facilis tempore, sit sunt enim
          exercitationem. Suscipit, fugit?
        
            </p>
            
        
            <p>
              
          Lorem ipsum dolor sit amet consectetur adipisicing elit. Sed rerum
          necessitatibus vero illo porro voluptatum fuga et quibusdam
          voluptates adipisci veniam, quas natus exercitationem atque
          voluptas tempora accusamus voluptate culpa!
        
            </p>
            
      
          </div>
          
    
        </div>
        

    
        <div
          aria-description="Tähän kysymykseen ei ole vastattu"
          className="e-exam-question e-level-0 e-mrg-b-8 e-clearfix no-answer"
          id="27"
        >
          
      
          <h3
            className="exam-question-title"
          >
            <strong
              className="exam-question-title__display-number"
            >
              27. 
            </strong>
            Margins and paddings
             
          </h3>
          
      
          <div
            className="exam-question-instruction e-mrg-b-2"
            id="question-instruction-192"
          >
            
        
            <p>
              
          For setting margin and padding there are own helper classes. The size set using
          numbers, e.g. in
          
              <code>
                e-pad-8
              </code>
              
          the padding is 8 times larger than in
          
              <code>
                e-pad-1
              </code>
              
          .
        
            </p>
            
        
            <p>
              You can use numbers 1 to 8.
            </p>
            
      
          </div>
          

      
          <table
            className="e-table e-width-full"
          >
            <thead>
              <tr>
                <th>
                  Class
                </th>
                <th>
                  Description
                </th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  
              
                  <code>
                    e-pad-*
                  </code>
                  
            
                </td>
                <td>
                  
              Padding to
              
                  <strong>
                    every direction
                  </strong>
                  
            
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-pad-l-*
                  </code>
                  
            
                </td>
                <td>
                  
              Padding to the
              
                  <strong>
                    left
                  </strong>
                  
            
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-pad-r-*
                  </code>
                  
            
                </td>
                <td>
                  
              Padding to the
              
                  <strong>
                    right
                  </strong>
                  
            
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-pad-l-*
                  </code>
                  
            
                </td>
                <td>
                  
              Padding to the
              
                  <strong>
                    top
                  </strong>
                  
            
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-pad-b-*
                  </code>
                  
            
                </td>
                <td>
                  
              Padding to the
              
                  <strong>
                    bottom
                  </strong>
                  
            
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-pad-x-*
                  </code>
                  
            
                </td>
                <td>
                  
              Padding to the
              
                  <strong>
                    left and right
                  </strong>
                  
            
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-pad-y-*
                  </code>
                  
            
                </td>
                <td>
                  
              Padding to the
              
                  <strong>
                    top and bottom
                  </strong>
                  
            
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-mrg-*
                  </code>
                  
            
                </td>
                <td>
                  
              Margin to
              
                  <strong>
                    every direction
                  </strong>
                  
            
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-mrg-l-*
                  </code>
                  
            
                </td>
                <td>
                  
              Margin to the
              
                  <strong>
                    left
                  </strong>
                  
            
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-mrg-r-*
                  </code>
                  
            
                </td>
                <td>
                  
              Margin to the
              
                  <strong>
                    right
                  </strong>
                  
            
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-mrg-t-*
                  </code>
                  
            
                </td>
                <td>
                  
              Margin to the
              
                  <strong>
                    top
                  </strong>
                  
            
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-mrg-b-*
                  </code>
                  
            
                </td>
                <td>
                  
              Margin to the
              
                  <strong>
                    bottom
                  </strong>
                  
            
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-mrg-x-*
                  </code>
                  
            
                </td>
                <td>
                  
              Margin to the
              
                  <strong>
                    left and right
                  </strong>
                  
            
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-mrg-y-*
                  </code>
                  
            
                </td>
                <td>
                  
              Margin to the
              
                  <strong>
                    top and bottom
                  </strong>
                  
            
                </td>
              </tr>
            </tbody>
          </table>
          

      
          <pre
            className="code"
          >
            &lt;div&gt;
  &lt;span class="e-pad-1"&gt;e-pad-1&lt;/span&gt;
  &lt;span class="e-pad-2"&gt;e-pad-2&lt;/span&gt;
  &lt;span class="e-pad-4"&gt;e-pad-4&lt;/span&gt;
  &lt;span class="e-pad-8"&gt;e-pad-8&lt;/span&gt;
&lt;/div&gt;
&lt;div&gt;
  &lt;span class="e-pad-l-1"&gt;e-pad-l-1&lt;/span&gt;
  &lt;span class="e-pad-l-2"&gt;e-pad-l-2&lt;/span&gt;
  &lt;span class="e-pad-l-4"&gt;e-pad-l-4&lt;/span&gt;
  &lt;span class="e-pad-l-8"&gt;e-pad-l-8&lt;/span&gt;
&lt;/div&gt;
&lt;div&gt;
  &lt;span class="e-pad-r-1"&gt;e-pad-r-1&lt;/span&gt;
  &lt;span class="e-pad-r-2"&gt;e-pad-r-2&lt;/span&gt;
  &lt;span class="e-pad-r-4"&gt;e-pad-r-4&lt;/span&gt;
  &lt;span class="e-pad-r-8"&gt;e-pad-r-8&lt;/span&gt;
&lt;/div&gt;
&lt;div&gt;
  &lt;span class="e-pad-x-1"&gt;e-pad-x-1&lt;/span&gt;
  &lt;span class="e-pad-x-2"&gt;e-pad-x-2&lt;/span&gt;
  &lt;span class="e-pad-x-4"&gt;e-pad-x-4&lt;/span&gt;
  &lt;span class="e-pad-x-8"&gt;e-pad-x-8&lt;/span&gt;
&lt;/div&gt;
&lt;div&gt;
  &lt;span class="e-pad-y-1"&gt;e-pad-y-1&lt;/span&gt;
  &lt;span class="e-pad-y-2"&gt;e-pad-y-2&lt;/span&gt;
  &lt;span class="e-pad-y-4"&gt;e-pad-y-4&lt;/span&gt;
  &lt;span class="e-pad-y-8"&gt;e-pad-y-8&lt;/span&gt;
&lt;/div&gt;
          </pre>
          
      
          <div
            className="example spacing-example"
          >
            
        
            <div>
              
          
              <span
                className="e-pad-1"
              >
                e-pad-1
              </span>
              
          
              <span
                className="e-pad-2"
              >
                e-pad-2
              </span>
              
          
              <span
                className="e-pad-4"
              >
                e-pad-4
              </span>
              
          
              <span
                className="e-pad-8"
              >
                e-pad-8
              </span>
              
        
            </div>
            
        
            <div>
              
          
              <span
                className="e-pad-l-1"
              >
                e-pad-l-1
              </span>
              
          
              <span
                className="e-pad-l-2"
              >
                e-pad-l-2
              </span>
              
          
              <span
                className="e-pad-l-4"
              >
                e-pad-l-4
              </span>
              
          
              <span
                className="e-pad-l-8"
              >
                e-pad-l-8
              </span>
              
        
            </div>
            
        
            <div>
              
          
              <span
                className="e-pad-r-1"
              >
                e-pad-r-1
              </span>
              
          
              <span
                className="e-pad-r-2"
              >
                e-pad-r-2
              </span>
              
          
              <span
                className="e-pad-r-4"
              >
                e-pad-r-4
              </span>
              
          
              <span
                className="e-pad-r-8"
              >
                e-pad-r-8
              </span>
              
        
            </div>
            
        
            <div>
              
          
              <span
                className="e-pad-x-1"
              >
                e-pad-x-1
              </span>
              
          
              <span
                className="e-pad-x-2"
              >
                e-pad-x-2
              </span>
              
          
              <span
                className="e-pad-x-4"
              >
                e-pad-x-4
              </span>
              
          
