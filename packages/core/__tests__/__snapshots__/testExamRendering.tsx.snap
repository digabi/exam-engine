                contentEditable={true}
                data-question-id={1}
                data-testid="rich-text-editor"
                id="1"
                onBlur={[Function]}
                onDragOver={[Function]}
                onDrop={[Function]}
                onFocus={[Function]}
                onInput={[Function]}
