                    fill="currentColor"
                  />
                </svg>
              </button>
              <div
                className="answer-toolbar e-font-size-xs e-columns e-mrg-b-2"
              >
                <div
                  className="answer-toolbar__answer-length e-column"
                >
                   
                </div>
                <div
                  className="answer-toolbar__history e-column e-column--narrow e-text-right"
                />
              </div>
            </div>
            
        
