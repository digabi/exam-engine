                      {
                        "__html": "<svg xmlns:xlink="http://www.w3.org/1999/xlink" width="3.235ex" height="2.009ex" style="vertical-align: -0.227ex;" viewBox="0 -767.4 1392.7 865.1" role="img" focusable="false" xmlns="http://www.w3.org/2000/svg" aria-labelledby="MathJax-SVG-1-Title">
