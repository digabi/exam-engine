          <div
            className="e-exam-question e-level-0 e-pad-b-8 e-clearfix"
            data-annotation-anchor="28"
            data-toc-id="question-28"
          >
            <div
              className="anchor"
              id="question-nr-28"
            />
            
      
            <h3
              className="exam-question-title"
              id="question-title-28"
            >
              <strong
                className="exam-question-title__display-number"
              >
                28. 
              </strong>
              Tables
               
              <span
                className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
              >
                0 p.
              </span>
            </h3>
            
      
            <div
              className="exam-question-instruction e-mrg-b-2"
              id="question-instruction-193"
            >
              
        Use classes
        
              <code>
                e-table
              </code>
              
        ,
        
              <code>
                e-table--borderless
              </code>
              
        , and
        
              <code>
                e-table--zebra
              </code>
              
        .
      
            </div>
            

      
            <pre
              className="code"
            >
              &lt;table class="e-table e-width-full"&gt;
  &lt;caption&gt;Table title&lt;/caption&gt;
  &lt;thead&gt;
    &lt;tr&gt;
      &lt;th&gt;First column&lt;/th&gt;
      &lt;th&gt;Second column&lt;/th&gt;
      &lt;th&gt;Third column&lt;/th&gt;
    &lt;/tr&gt;
  &lt;/thead&gt;
  &lt;tbody&gt;
    &lt;tr&gt;
      &lt;td&gt;Lorem&lt;/td&gt;
      &lt;td&gt;Ipsum&lt;/td&gt;
      &lt;td&gt;Dolor&lt;/td&gt;
    &lt;/tr&gt;
  &lt;/tbody&gt;
&lt;/table&gt;
            </pre>
            
      
            <div
              className="example"
            >
              
        
              <table
                className="e-table e-width-full"
              >
                <caption>
                  Table title
                </caption>
                <thead>
                  <tr>
                    <th>
                      First column
                    </th>
                    <th>
                      Second column
                    </th>
                    <th>
                      Third column
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>
                      Lorem
                    </td>
                    <td>
                      Ipsum
                    </td>
                    <td>
                      Dolor
                    </td>
                  </tr>
                </tbody>
              </table>
              
      
            </div>
            

      
            <pre
              className="code"
            >
              &lt;table class="e-table e-table--borderless e-width-full"&gt;
  &lt;caption&gt;Table title&lt;/caption&gt;
  &lt;thead&gt;
  &lt;tr&gt;
      &lt;th&gt;First column&lt;/th&gt;
      &lt;th&gt;Second column&lt;/th&gt;
      &lt;th&gt;Third column&lt;/th&gt;
    &lt;/tr&gt;
  &lt;/thead&gt;
  &lt;tbody&gt;
    &lt;tr&gt;
      &lt;td&gt;Lorem&lt;/td&gt;
      &lt;td&gt;Ipsum&lt;/td&gt;
      &lt;td&gt;Dolor&lt;/td&gt;
    &lt;/tr&gt;
  &lt;/tbody&gt;
&lt;/table&gt;
            </pre>
            
      
            <div
              className="example"
            >
              
        
              <table
                className="e-table e-table--borderless e-width-full"
              >
                <caption>
                  Table title
                </caption>
                <thead>
                  <tr>
                    <th>
                      First column
                    </th>
