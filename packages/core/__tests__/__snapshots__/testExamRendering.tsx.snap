        <h2
          className="exam-section-title"
          data-annotation-anchor="section-title-6"
          data-toc-id="section-6"
          id="section-title-6"
        >
          Osa 6:
           
          Links to material
        </h2>
        
    
        <div
          aria-description="Tähän kysymykseen ei ole vastattu"
          className="e-exam-question e-level-0 e-mrg-b-8 e-clearfix no-answer"
          id="20"
        >
          
      
          <h3
            className="exam-question-title"
          >
            <strong
              className="exam-question-title__display-number"
            >
              20. 
            </strong>
            attachment-link
             
          </h3>
          
      
          <div
            className="exam-question-instruction e-mrg-b-2"
            id="question-instruction-187"
          >
            
        Material on external material page can be linked to from exam page by using
        
            <code>
              e:attachment-link
            </code>
            
        element.
      
          </div>
          

      
          <table
            className="e-table e-width-full"
          >
            <caption>
              
          Element attributes
        
            </caption>
            <thead>
              <tr>
                <th>
                  Attribute
                </th>
                <th>
                  Type
                </th>
                <th>
                  Mandatory
                </th>
                <th>
                  Default value
                </th>
                <th>
                  Description
                </th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  ref
                </td>
                <td>
                  String
                </td>
                <td>
                  Yes
                </td>
                <td>
                  –
                </td>
                <td>
                  
              Value of the linked
              
                  <code>
                    e:attachment
                  </code>
                  
              's
              
                  <code>
                    name
                  </code>
                  
              attribute.
            
                </td>
              </tr>
              <tr>
                <td>
                  type
                </td>
                <td>
                  
              
                  <code>
                    long | short
                  </code>
                  
            
                </td>
                <td>
                  No
                </td>
                <td>
                  
              
                  <code>
                    long
                  </code>
                  
            
                </td>
                <td>
                  Type of the reference, see example below.
                </td>
              </tr>
              <tr>
                <td>
                  meta
                </td>
                <td>
                  String
                </td>
                <td>
                  No
                </td>
                <td>
                  –
                </td>
                <td>
                  Metadata about element
                </td>
              </tr>
            </tbody>
          </table>
          

      
          <h4>
            Example
          </h4>
          
      
          <pre
            className="code"
          >
            &lt;e:attachment-link ref="test-material" /&gt;
&lt;e:attachment-link ref="another-test-material" type="short" /&gt;
          </pre>
          
      
          <div
            className="example"
          >
            
        
            <code>
              long
            </code>
            
        type reference:
        
            (
            <span
              className="attachment-link e-nowrap"
            >
              aineisto
               
              13.A
            </span>
            )
            
        
            <br />
            
        
            <code>
              short
            </code>
            
        type reference:
        
            <span
              className="attachment-link e-nowrap"
            >
              13.B
            </span>
            
      
          </div>
          

    
        </div>
        

    
        <div
          aria-description="Tähän kysymykseen ei ole vastattu"
          className="e-exam-question e-level-0 e-mrg-b-8 e-clearfix no-answer"
          id="21"
        >
          
      
          <h3
            className="exam-question-title"
          >
            <strong
              className="exam-question-title__display-number"
            >
              21. 
            </strong>
            attachment-links
             
          </h3>
          
      
          <div
            className="exam-question-instruction e-mrg-b-2"
            id="question-instruction-188"
          >
            
        Use
        
            <code>
              e:attachment-links
            </code>
            
        element to refere to multiple materials.
      
          </div>
          

      
          <h4>
            Example
          </h4>
          
      
          <pre
            className="code"
          >
            &lt;e:attachment-links&gt;
  &lt;e:attachment-link ref="test-material" /&gt;
  &lt;e:attachment-link ref="another-test-material" /&gt;
&lt;/e:attachment-links&gt;
&lt;e:attachment-links type="short"&gt;
  &lt;e:attachment-link ref="test-material" /&gt;
  &lt;e:attachment-link ref="another-test-material" /&gt;
&lt;/e:attachment-links&gt;
          </pre>
          
      
          <div
            className="example"
          >
            
        
            (
            <span
              className="attachment-link e-nowrap"
            >
              aineistot
               
              13.A–13.B
            </span>
            )
            
        
            <br />
            
        
            <span
              className="attachment-link e-nowrap"
            >
              13.A–13.B
            </span>
            
      
          </div>
          
    
        </div>
        
  
      </div>
    </section>
    

  
    <section
      aria-labelledby="section-title-7"
      className="e-section e-bg-color-off-white e-pad-6"
    >
      <div
        className="e-results-section-wrapper"
      >
        
    
        <h2
          className="exam-section-title"
          data-annotation-anchor="section-title-7"
          data-toc-id="section-7"
          id="section-title-7"
        >
          Osa 7:
           
          Formulas
        </h2>
        
    
        <div
          aria-description="Tähän kysymykseen ei ole vastattu"
          className="e-exam-question e-level-0 e-mrg-b-8 e-clearfix no-answer"
          id="22"
        >
          
      
          <h3
            className="exam-question-title"
          >
            <strong
              className="exam-question-title__display-number"
            >
              22. 
            </strong>
            Adding formulas
             
          </h3>
          
      
          <div
            className="exam-question-instruction e-mrg-b-2"
            id="question-instruction-189"
          >
            
        
            <p>
              
          You can add
          
              <span
                aria-hidden="true"
                className="e-formula"
                dangerouslySetInnerHTML={
                  {
                    "__html": "<svg xmlns:xlink="http://www.w3.org/1999/xlink" width="6.461ex" height="2.454ex" style="vertical-align: -0.671ex;" viewBox="0 -767.4 2781.7 1056.5" role="img" focusable="false" xmlns="http://www.w3.org/2000/svg" aria-labelledby="MathJax-SVG-1-Title">
