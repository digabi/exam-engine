                        dangerouslySetInnerHTML={
                          {
                            "__html": "<svg xmlns:xlink="http://www.w3.org/1999/xlink" width="6.014ex" height="2.676ex" style="vertical-align: -0.782ex;" viewBox="0 -815.3 2589.3 1152.1" role="img" focusable="false" xmlns="http://www.w3.org/2000/svg" aria-labelledby="MathJax-SVG-1-Title">
