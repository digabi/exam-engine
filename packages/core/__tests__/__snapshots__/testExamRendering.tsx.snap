          </div>
          
    
          <div
            className="e-exam-question e-level-0 e-pad-b-8 e-clearfix"
            data-annotation-anchor="14"
            data-toc-id="question-14"
          >
            <div
              className="anchor"
              id="question-nr-14"
            />
            
      
            <h3
              className="exam-question-title"
              id="question-title-14"
            >
              <strong
                className="exam-question-title__display-number"
              >
                14. 
              </strong>
              image
               
              <span
                className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
              >
                0 p.
              </span>
            </h3>
            
      
            <div
              className="exam-question-instruction e-mrg-b-2"
              id="question-instruction-181"
            >
              
        
              <code>
                e:image
              </code>
              
        element adds an image to the exam. It can be used anywhere where
        HTML is allowed.
      
            </div>
            

      
            <table
              className="e-table e-width-full"
            >
              <caption>
                Element attributes
              </caption>
              <thead>
                <tr>
                  <th>
                    Attribute
                  </th>
                  <th>
                    Type
                  </th>
                  <th>
                    Mandatory
                  </th>
                  <th>
                    Default value
                  </th>
                  <th>
                    Description
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>
                    src
                  </td>
                  <td>
                    String
                  </td>
                  <td>
                    Yes
                  </td>
                  <td>
                    –
                  </td>
                  <td>
                    Filename of the image
                  </td>
                </tr>
                <tr>
                  <td>
                    lang
                  </td>
                  <td>
                    String
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    –
                  </td>
                  <td>
                    Exam language code. Use when image should be included only in certain language version.
            
                  </td>
                </tr>
                <tr>
                  <td>
                    class
                  </td>
                  <td>
                    CSS class
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    -
                  </td>
                  <td>
                    CSS class name
                  </td>
                </tr>
              </tbody>
            </table>
            

      
            <h4>
              Example
            </h4>
            
      
            <pre
              className="code"
            >
              &lt;e:image src="example.jpg"&gt;
  &lt;e:image-title&gt;Optional image title text&lt;/e:image-title&gt;
&lt;/e:image&gt;
            </pre>
            
      
            <div
              className="example"
            >
              
        
              <span
                className="responsive-media-container responsive-media-container--bordered"
                style={
                  {
                    "maxWidth": 988,
                  }
                }
              >
                <span
                  className="responsive-media-container__inner"
                  style={
                    {
                      "paddingBottom": "74.84536082474227%",
                    }
                  }
                >
                  <a
                    aria-hidden={false}
                    className="e-zoomable"
                    href="/attachments/example.jpg"
                    tabIndex={-1}
                    target="original-picture"
                    title="Suurenna kuva"
                  >
                    <img
                      alt=""
                      aria-labelledby="image-caption-213"
                      className="e-image"
                      src="/attachments/example.jpg"
                    />
                  </a>
                </span>
                <span
                  className="e-block e-mrg-t-1 e-font-size-s e-light"
                  id="image-caption-213"
                >
                  Optional image title text
                </span>
              </span>
              
      
            </div>
            
    
          </div>
          
    
          <div
            className="e-exam-question e-level-0 e-pad-b-8 e-clearfix"
            data-annotation-anchor="15"
            data-toc-id="question-15"
          >
            <div
              className="anchor"
              id="question-nr-15"
            />
            
      
            <h3
              className="exam-question-title"
              id="question-title-15"
            >
              <strong
                className="exam-question-title__display-number"
              >
                15. 
              </strong>
              image-overlay
               
              <span
                className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
              >
                0 p.
              </span>
            </h3>
            
      
            <div
              className="exam-question-instruction e-mrg-b-2"
              id="question-instruction-182"
            >
              
        
              <p>
                
          
                <code>
                  e:image-overlay
                </code>
                
          element can contain one or more image elements. It can be used anywhere where
        HTML is allowed. The images are rendered on top of each other, and an input slider
        is added for each image to allow for the adjustment of the opacity (transparency) of
        the image. The label for each input slider is taken from the text
        inside each
          
                <code>
                  e:image
                </code>
                
          element. The text can be localized.
        
              </p>
              
        
              <p>
                Make sure that all the images have the same width
          and height in pixels. Differently sized images will cause unwanted layout effects.
        
              </p>
              
      
            </div>
            

      
            <table
              className="e-table e-width-full"
            >
              <caption>
                Element attributes
              </caption>
              <thead>
                <tr>
                  <th>
                    Attribute
                  </th>
                  <th>
                    Type
                  </th>
                  <th>
                    Mandatory
                  </th>
                  <th>
                    Default value
                  </th>
                  <th>
                    Description
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>
                    lang
                  </td>
                  <td>
                    String
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    –
                  </td>
                  <td>
                    Exam language code. Use when image-overlay should be included only in a certain language version.
            
                  </td>
                </tr>
                <tr>
                  <td>
                    meta
                  </td>
                  <td>
                    String
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    –
                  </td>
                  <td>
                    Metadata about element
                  </td>
                </tr>
              </tbody>
            </table>
            

      
            <h4>
              Example
            </h4>
            
      
            <pre
              className="code"
            >
              &lt;e:image-overlay&gt;
  &lt;e:image src="map-example-1.jpg"&gt;
    &lt;e:image-title&gt;Topographic Map&lt;/e:image-title&gt;
  &lt;/e:image&gt;
  &lt;e:image src="map-example-2.jpg"&gt;
    &lt;e:image-title&gt;Public Transport Map
  &lt;/e:image&gt;
  &lt;e:image src="map-example-3.jpg"&gt;
    &lt;e:image-title&gt;Bike Lanes Map&lt;e:image-title&gt;
  &lt;/e:image&gt;
&lt;/e:image-overlay&gt;
            </pre>
            
      
