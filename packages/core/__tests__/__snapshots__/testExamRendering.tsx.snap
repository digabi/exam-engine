            <p>
              
        Notice that certain characters in formulas require special notation.
      
            </p>
            
      
            <table
              className="e-table"
            >
              <caption />
              <thead>
                <tr>
                  <th>
                    Character
                  </th>
                  <th>
                    Notation
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>
                    &gt;
                  </td>
                  <td>
                    
              
                    <code>
                      &gt;
                    </code>
                    
            
                  </td>
                </tr>
                <tr>
                  <td>
                    &lt;
                  </td>
                  <td>
                    
              
                    <code>
                      &lt;
                    </code>
                    
            
                  </td>
                </tr>
                <tr>
                  <td>
                    &
                  </td>
                  <td>
                    
              
                    <code>
                      &amp;
                    </code>
                    
            
                  </td>
                </tr>
              </tbody>
            </table>
            
      
            <p>
              
        For longer formulas also
        
              <code>
                
          
                &lt;e:formula&gt;
                
          &lt;![CDATA[ latex-code ]]&gt;
          
                &lt;/e:formula&gt;
                
        
              </code>
              
        may also be used. Inside a CDATA-block escaping is not required.
      
            </p>
            

      
            <h4>
              
        Example of an
        
              <code>
                inline
              </code>
              
        formula
      
            </h4>
            
      
            <pre
              className="code"
            >
              &lt;e:formula&gt;\\int_0^\\infty e^{-x^2} dx=\\frac{\\sqrt{\\pi}}{2}&lt;/e:formula&gt;
            </pre>
            
      
            <p>
              
        
