  </section>
  

  
  <section
    aria-labelledby="section-title-8"
    className="e-section e-bg-color-off-white e-pad-6 e-grading-instruction-section"
  >
    
    
    <h2
      className="e-grading-instructions-section-title"
      data-annotation-anchor="section-title-8"
      id="section-title-8"
    >
      Osa 8:
       
      CSS styles
    </h2>
    

    
    <div
      className="e-grading-instructions-question e-mrg-b-8 e-clearfix"
      data-annotation-anchor="23"
      id="23"
    >
      <div
        className="anchor"
        id="question-nr-23"
      />
      <h3
        className="exam-question-title"
      >
        <strong
          className="exam-question-title__display-number"
        >
          23. 
        </strong>
        Typography
         
        <span
          className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
        >
          0 p.
        </span>
      </h3>
    </div>
    

    
    <div
      className="e-grading-instructions-question e-mrg-b-8 e-clearfix"
      data-annotation-anchor="24"
      id="24"
    >
      <div
        className="anchor"
        id="question-nr-24"
      />
      <h3
        className="exam-question-title"
      >
        <strong
          className="exam-question-title__display-number"
        >
          24. 
        </strong>
        Lists
         
        <span
          className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
        >
          0 p.
        </span>
      </h3>
      <div
        className="exam-question-instruction e-mrg-b-2"
        id="question-instruction-190"
      >
        There are helper classes for various ordered lists.
      </div>
    </div>
    

    
    <div
      className="e-grading-instructions-question e-mrg-b-8 e-clearfix"
      data-annotation-anchor="25"
      id="25"
    >
      <div
        className="anchor"
        id="question-nr-25"
      />
      <h3
        className="exam-question-title"
      >
        <strong
          className="exam-question-title__display-number"
        >
          25. 
        </strong>
        Floating
         
        <span
          className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
        >
          0 p.
        </span>
      </h3>
    </div>
    

    
    <div
      className="e-grading-instructions-question e-mrg-b-8 e-clearfix"
      data-annotation-anchor="26"
      id="26"
    >
      <div
        className="anchor"
        id="question-nr-26"
      />
      <h3
        className="exam-question-title"
      >
        <strong
          className="exam-question-title__display-number"
        >
          26. 
        </strong>
        Illustration images
         
        <span
          className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
        >
          0 p.
        </span>
      </h3>
      <div
        className="exam-question-instruction e-mrg-b-2"
        id="question-instruction-191"
      >
        
        For images aligned to the right there is a helper class
        
        <code>
          e-illustration-right
        </code>
        
        .
        In addition to right alignment, it adds proper margins. The class does not restrict
        image size, therefore
        
        <code>
          e-width-*
        </code>
        
        classes can be used simultaneously.
      
      </div>
    </div>
    

    
    <div
      className="e-grading-instructions-question e-mrg-b-8 e-clearfix"
      data-annotation-anchor="27"
      id="27"
    >
      <div
        className="anchor"
        id="question-nr-27"
      />
      <h3
        className="exam-question-title"
      >
        <strong
          className="exam-question-title__display-number"
        >
          27. 
        </strong>
        Margins and paddings
         
        <span
          className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
        >
          0 p.
        </span>
      </h3>
      <div
        className="exam-question-instruction e-mrg-b-2"
        id="question-instruction-192"
      >
        
        
        <p>
          
          For setting margin and padding there are own helper classes. The size set using
          numbers, e.g. in
          
          <code>
            e-pad-8
          </code>
          
          the padding is 8 times larger than in
          
          <code>
            e-pad-1
          </code>
          
          .
        
        </p>
        
        
        <p>
          You can use numbers 1 to 8.
        </p>
        
      
      </div>
    </div>
    

    
    <div
      className="e-grading-instructions-question e-mrg-b-8 e-clearfix"
      data-annotation-anchor="28"
      id="28"
    >
      <div
        className="anchor"
        id="question-nr-28"
      />
      <h3
        className="exam-question-title"
      >
        <strong
          className="exam-question-title__display-number"
        >
          28. 
        </strong>
        Tables
         
        <span
          className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
        >
          0 p.
        </span>
      </h3>
      <div
        className="exam-question-instruction e-mrg-b-2"
        id="question-instruction-193"
      >
        
        Use classes
        
        <code>
          e-table
        </code>
        
        ,
        
        <code>
          e-table--borderless
        </code>
        
        , and
        
        <code>
          e-table--zebra
        </code>
        
        .
      
      </div>
    </div>
    

    
    <div
      className="e-grading-instructions-question e-mrg-b-8 e-clearfix"
      data-annotation-anchor="29"
      id="29"
    >
      <div
        className="anchor"
        id="question-nr-29"
      />
      <h3
        className="exam-question-title"
      >
        <strong
          className="exam-question-title__display-number"
        >
          29. 
        </strong>
        Text columns
         
        <span
          className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
        >
          0 p.
        </span>
      </h3>
      <div
        className="exam-question-instruction e-mrg-b-2"
        id="question-instruction-194"
      >
        
        
        <p>
          
          Text columns can be added using
          
          <code>
            e-columns
          </code>
          
          class. Ever child element within it must have
          
          <code>
            
          e-column
          </code>
          
          class
        
        </p>
        
        
        <p>
          There is some empty space between columns.
        </p>
        
      
      </div>
    </div>
    
  
  </section>
  

  
  
  
  

</main>
`;

exports[`MexDocumentation.xml > renders properly > <Results /> 1`] = `
[
  <main
    className="e-exam e-results"
    lang="fi-FI"
  >
    <link
      href="/attachments/custom.css"
      rel="stylesheet"
    />
    <div
      className="e-columns e-columns--bottom-v e-mrg-b-4"
    >
      <h1
        className="e-column e-mrg-b-0"
        id="title"
      >
        MEX format documentation
        , 27.1.2022
      </h1>
      <div
        className="e-column--narrow"
      >
        <table
          className="e-table e-table--borderless e-mrg-b-0"
        >
          <tbody>
            <tr>
              <th
                className="e-pad-y-0 e-normal"
              >
                Yhteensä
              </th>
              <td
                className="e-pad-y-0 e-semibold e-text-right"
              >
                20 p.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    
  
  
    
  
    
  
    
  
    
  
    <section
      aria-labelledby="section-title-1"
      className="e-section e-bg-color-off-white e-pad-6"
    >
      <div
        className="e-results-section-wrapper"
      >
        
    
        <h2
          className="exam-section-title"
          data-annotation-anchor="section-title-1"
          data-toc-id="section-1"
          id="section-title-1"
        >
          Osa 1:
           
          Exam structure
        </h2>
        
    
        <div
          aria-description="Tähän kysymykseen ei ole vastattu"
          className="e-exam-question e-level-0 e-mrg-b-8 e-clearfix no-answer"
          id="1"
        >
          
      
          <h3
            className="exam-question-title"
          >
            <strong
              className="exam-question-title__display-number"
            >
              1. 
            </strong>
            XML structure
             
          </h3>
          
      
          <div
            className="exam-question-instruction e-mrg-b-2"
            id="question-instruction-167"
          >
            Exam structure is described in XML. It can contain also (X)HTML elements.
      
          </div>
          
      
          <div
            className="tree"
          >
            
        
            <div>
              
          
              <strong>
                
            Exam
            
                <code>
                  &lt;e:exam&gt;
                </code>
                
          
              </strong>
              
          1 element
          
              <p>
                
            Root element of the exam. All other elements are its descendants.
          
              </p>
              
          
              <div>
                
            
                <strong>
                  
              Exam languages
              
                  <code>
                    &lt;e:languages&gt;
                  </code>
                  
            
                </strong>
                
            1 element
            
                <div>
                  
              
                  <strong>
                    
                Exam language
                
                    <code>
                      &lt;e:language&gt;
                    </code>
                    
              
                  </strong>
                  
              1-n elements
            
                </div>
                
          
              </div>
              
          
              <div>
                
            
                <strong>
                  
              Exam title
              
                  <code>
                    &lt;e:exam-title&gt;
                  </code>
                  
            
                </strong>
                
            1 element
          
              </div>
              
          
              <div>
                
            
                <strong>
                  
              Exam introduction and instructions
              
                  <code>
                    &lt;e:exam-instruction&gt;
                  </code>
                  
            
                </strong>
                
            1 element
          
              </div>
              
          
              <div>
                
            
                <strong>
                  
              Reference to exam introduction and instructions read from file
              
                  <code>
                    &lt;e:exam-instruction-ref&gt;
                  </code>
                  
            
                </strong>
                
            1 element
          
              </div>
              
          
              <div>
                
            
                <strong>
                  
              Table of contents
              
                  <code>
                    &lt;e:table-of-contents&gt;
                  </code>
                  
            
                </strong>
                
            1 element
          
              </div>
              
          
              <div>
                
            
                <strong>
                  
              Exam-specific external material
              
                  <code>
                    &lt;e:external-material&gt;
                  </code>
                  
            
                </strong>
                
            0-1 elements
            
                <p>
                  
              External material page is constructed based on
              
                  <code>
                    e:external-material
                  </code>
                  
              elements
              defined within
              
                  <code>
                    e:exam
                  </code>
                  
              and
              
                  <code>
                    e:question
                  </code>
                  
              elements.
              Contains
              
                  <code>
                    e:attachment
                  </code>
                  
              elements.
            
                </p>
                
          
              </div>
              
          
              <div>
                
            
                <strong>
                  
              Section
              
                  <code>
                    &lt;e:section&gt;
                  </code>
                  
            
                </strong>
                
            1-n elements
            
                <p>
                  Section groups questions
                </p>
                
            
                <div>
                  
              
                  <strong>
                    
                Section title
                
                    <code>
                      &lt;e:section-title&gt;
                    </code>
                    
              
                  </strong>
                  
              1 element
              
                  <p>
                    Section title can contain HTML elements. Section number is added automatically.
                  </p>
                  
            
                </div>
                
            
                <div>
                  
              
                  <strong>
                    
                Section instructions
                
                    <code>
                      &lt;e:section-instruction&gt;
                    </code>
                    
              
                  </strong>
                  
              0-n elements
              
                  <p>
                    Section instructions can contain HTML elements.
                  </p>
                  
            
                </div>
                
            
                <div>
                  
              
                  <strong>
                    
                Question
                
                    <code>
                      &lt;e:question&gt;
                    </code>
                    
              
                  </strong>
                  
              0-n elements
              
                  <p>
                    
                Questions can contain sub-
                
                    <code>
                      e:question
                    </code>
                    
                s
              
                  </p>
                  
              
                  <div>
                    
                
                    <strong>
                      
                  Question title
                  
                      <code>
                        &lt;e:question-title&gt;
                      </code>
                      
                
                    </strong>
                    
                1 element
                
                    <p>
                      Question title can contain HTML elements. Question number is added automatically.
                    </p>
                    
              
                  </div>
                  
              
                  <div>
                    
                
                    <strong>
                      
                  Question instructions
                  
                      <code>
                        &lt;e:question-instruction&gt;
                      </code>
                      
                
                    </strong>
                    
                0-1 elements
                
                    <p>
                      Question instructions can contain HTML elements.
                    </p>
                    
              
                  </div>
                  
              
                  <div>
                    
                
                    <strong>
                      
                  Question-specific external material
                  
                      <code>
                        &lt;e:external-material&gt;
                      </code>
                      
                
                    </strong>
                    
                0-1 elements
                
                    <p>
                      
                  External material page is constructed based on
                  
                      <code>
                        e:external-material
                      </code>
                      
                  elements
                  defined within
                  
                      <code>
                        e:exam
                      </code>
                      
                  and
                  
                      <code>
                        e:question
                      </code>
                      
                  elements.
                  Contains
                  
                      <code>
                        e:attachment
                      </code>
                      
                  elements.
                
                    </p>
                    
              
                  </div>
                  
              
                  <div>
                    
                
                    <strong>
                      
                  Internal material
                  
                      <code>
                        &lt;e:attachment&gt;
                      </code>
                      
                
                    </strong>
                    
                0-n elements
                
                    <p>
                      
                  Internal material is displayed directly on exam page. Use
                  
                      <code>
                        e:external-material
                      </code>
                      
                  to
                  display material on separate external material page.
                
                    </p>
                    
                
                    <div>
                      
                  
                      <strong>
                        
                    Material title
                    
                        <code>
                          &lt;e:attachment-title&gt;
                        </code>
                        
                  
                      </strong>
                      
                  1 element
                
                    </div>
                    
                
                    <div>
                      
                  
                      <strong>
                        
                    Audio material
                    
                        <code>
                          &lt;e:audio&gt;
                        </code>
                        
                  
                      </strong>
                      
                  0-1 elements
                
                    </div>
                    
                
                    <div>
                      
                  
                      <strong>
                        
                    Image material
                    
                        <code>
                          &lt;e:image&gt;
                        </code>
                        
                  
                      </strong>
                      
                  0-1 elements
                
                    </div>
                    
                
                    <div>
                      
                  
                      <strong>
                        
                    Video material
                    
                        <code>
                          &lt;e:video&gt;
                        </code>
                        
                  
                      </strong>
                      
                  0-1 elements
                
                    </div>
                    
                
                    <div>
                      
                  
                      <strong>
                        
                    Material reference
                    
                        <code>
                          &lt;e:reference&gt;
                        </code>
                        
                  
                      </strong>
                      
                  1 element. See section Material below for details.
                
                    </div>
                    
              
                  </div>
                  
              
                  <div>
                    
                
                    <strong>
                      
                  Answer type, e.g.
                  
                      <code>
                        &lt;e:text-answer&gt;
                      </code>
                      
                
                    </strong>
                    
                0-n elements
                
                    <p>
                      See section Answer types below for details.
                    </p>
                    
              
                  </div>
                  
              
                  <div>
                    
                
                    <strong>
                      
                  Question number,
                  
                      <code>
                        &lt;e:question-number&gt;
                      </code>
                      
                
                    </strong>
                    
                0-n elements
                
                    <p>
                      To show parent question number as a prefix and fixed number as a suffix.
                    </p>
                    
              
                  </div>
                  
              
                  <div>
                    
                
                    <strong>
