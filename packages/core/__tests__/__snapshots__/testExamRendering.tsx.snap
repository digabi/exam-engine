                </li>
                
        
              </ol>
              
      
            </div>
            

      
            <pre
              className="code"
            >
              &lt;ol class="e-list-upper-alpha"&gt;
  &lt;li&gt;Eka&lt;/li&gt;
  &lt;li&gt;Toka&lt;/li&gt;
  &lt;li&gt;Kolmas&lt;/li&gt;
&lt;/ol&gt;
            </pre>
            
      
            <div
              className="example"
