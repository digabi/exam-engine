        </div>
        
  
      </div>
    </section>
    

  
    <section
      aria-labelledby="section-title-8"
      className="e-section e-bg-color-off-white e-pad-6"
    >
      <div
        className="e-results-section-wrapper"
      >
        
    
        <h2
          className="exam-section-title"
          data-annotation-anchor="section-title-8"
          data-toc-id="section-8"
          id="section-title-8"
        >
          Osa 8:
           
          CSS styles
        </h2>
        

    
        <div
          aria-description="Tähän kysymykseen ei ole vastattu"
          className="e-exam-question e-level-0 e-mrg-b-8 e-clearfix no-answer"
          id="23"
        >
          
      
          <h3
            className="exam-question-title"
          >
            <strong
              className="exam-question-title__display-number"
            >
              23. 
            </strong>
            Typography
             
          </h3>
          

      
          <h3>
            Title
          </h3>
          
      
          <p>
            All common header levels are in use.
          </p>
          

      
          <pre
            className="code"
          >
            &lt;h1&gt;h1. Title (40px, light)&lt;/h1&gt;
&lt;h2&gt;h2. Title (30px, normal)&lt;/h2&gt;
&lt;h3&gt;h3. Title (21px, semibold)&lt;/h3&gt;
&lt;h4&gt;h4. Title (18px, semibold)&lt;/h4&gt;
&lt;h5&gt;h5. Title (16px, semibold)&lt;/h5&gt;
&lt;h6&gt;h6. Title (16px, semibold)&lt;/h6&gt;
          </pre>
          
      
          <div
            className="example"
          >
            
        
            <h1>
              h1. Title (40px, light)
            </h1>
            
        
            <h2>
              h2. Title (30px, normal)
            </h2>
            
        
            <h3>
              h3. Title (21px, semibold)
            </h3>
            
        
            <h4>
              h4. Title (18px, semibold)
            </h4>
            
        
            <h5>
              h5. Title (16px, semibold)
            </h5>
            
        
            <h6>
              h6. Title (16px, semibold)
            </h6>
            
      
          </div>
          

      
          <br />
          

      
          <h3>
            Text size
          </h3>
          
      
          <p>
            
        Text size can be modified using
        
            <code>
              e-font-size-*
            </code>
            
        classes.
      
          </p>
          
      
          <pre
            className="code"
          >
            &lt;p class="e-font-size-xxxl"&gt;.e-font-size-xxxl: (40px)&lt;/p&gt;
&lt;p class="e-font-size-xxl"&gt;.e-font-size-xxl: (30px)&lt;/p&gt;
&lt;p class="e-font-size-xl"&gt;.e-font-size-xl: (21px)&lt;/p&gt;
&lt;p class="e-font-size-l"&gt;.e-font-size-l: (18px)&lt;/p&gt;
&lt;p class="e-font-size-m"&gt;.e-font-size-m: (16px, tekstin oletuskoko)&lt;/p&gt;
&lt;p class="e-font-size-s"&gt;.e-font-size-s: (14px)&lt;/p&gt;
&lt;p class="e-font-size-xs"&gt;.e-font-size-xs: (12px)&lt;/p&gt;
          </pre>
          
      
          <div
            className="example"
          >
            
        
            <p
              className="e-font-size-xxxl"
            >
              .e-font-size-xxxl: (40px)
            </p>
            
        
            <p
              className="e-font-size-xxl"
            >
              .e-font-size-xxl: (30px)
            </p>
            
        
            <p
              className="e-font-size-xl"
            >
              .e-font-size-xl: (21px)
            </p>
            
        
            <p
              className="e-font-size-l"
            >
              .e-font-size-l: (18px)
            </p>
            
        
            <p
              className="e-font-size-m"
            >
              .e-font-size-m: (16px, tekstin oletuskoko)
            </p>
            
        
            <p
              className="e-font-size-s"
            >
              .e-font-size-s: (14px)
            </p>
            
        
            <p
              className="e-font-size-xs"
            >
              .e-font-size-xs: (12px)
            </p>
            
      
          </div>
          

      
          <h3>
            Typefaces
          </h3>
          
      
          <p>
            
        Typeface can be modified using
        
            <code>
              e-semibold
            </code>
            
        ,
        
            <code>
              e-light
            </code>
            
        ,
        
            <code>
              e-italic
            </code>
            
        , and
        
            <code>
              e-normal
            </code>
            
        classes.
      
          </p>
          

      
          <pre
            className="code"
          >
            &lt;p class="e-semibold"&gt;.e-semibold: Lorem ipsum dolor sit amet&lt;/p&gt;
&lt;p class="e-light"&gt;.e-light: Lorem ipsum dolor sit amet&lt;/p&gt;
&lt;p class="e-italic"&gt;.e-italic: Lorem ipsum dolor sit amet&lt;/p&gt;
&lt;p class="e-normal"&gt;.e-normal: Lorem ipsum dolor sit amet&lt;/p&gt;
&lt;p class="e-underline"&gt;.e-underline: Lorem ipsum dolor sit amet&lt;/p&gt;
          </pre>
          
      
          <div
            className="example"
          >
            
        
            <p
              className="e-semibold"
            >
              .e-semibold: Lorem ipsum dolor sit amet
            </p>
            
        
            <p
              className="e-light"
            >
              .e-light: Lorem ipsum dolor sit amet
            </p>
            
        
            <p
              className="e-italic"
            >
              .e-italic: Lorem ipsum dolor sit amet
            </p>
            
        
            <p
              className="e-normal"
            >
              .e-normal: Lorem ipsum dolor sit amet
            </p>
            
        
            <p
              className="e-underline"
            >
              .e-underline: Lorem ipsum dolor sit amet
            </p>
            
      
          </div>
          

      
          <h3>
            Text positioning
          </h3>
          
      
          <p>
            
        Text can be positioned both horizontally and vertically by using
        
            <code>
              e-text-*
            </code>
            
        classes.
      
          </p>
          
      
          <table
            className="e-table e-width-full"
          >
            <thead>
              <tr>
                <th>
                  Class
                </th>
                <th>
                  Description
                </th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  
              
                  <code>
                    e-text-center
                  </code>
                  
            
                </td>
                <td>
                  
              
                  <strong>
                    Centers
                  </strong>
                  
              text
            
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-text-left
                  </code>
                  
            
                </td>
                <td>
                  
              Aligns text to the
              
                  <strong>
                    left
                  </strong>
                  
            
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-text-right
                  </code>
                  
            
                </td>
                <td>
                  
              Aligns text to the
              
                  <strong>
                    right
                  </strong>
                  
            
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-text-justify
                  </code>
                  
            
                </td>
                <td>
                  
              
                  <strong>
                    Justifies
                  </strong>
                  
              text
            
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-text-top
                  </code>
                  
            
                </td>
                <td>
                  
              Aligns text to the
              
                  <strong>
                    top
                  </strong>
                  
            
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-text-bottom
                  </code>
                  
            
                </td>
                <td>
                  
              Aligns text to the
              
                  <strong>
                    bottom
                  </strong>
                  
            
                </td>
              </tr>
            </tbody>
          </table>
          

      
          <h3>
            Text helper classes
          </h3>
          
      
          <table
            className="e-table e-width-full"
          >
            <thead>
              <tr>
                <th>
                  Class
                </th>
                <th>
                  Description
                </th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  
              
                  <code>
                    e-nowrap
                  </code>
                  
            
                </td>
                <td>
                  Prevent line wrapping
                </td>
              </tr>
              <tr>
                <td>
                  
              
                  <code>
                    e-text-gap
                  </code>
                  
            
                </td>
                <td>
                  
              Create underlined gap within
              
                  <span
                    className="e-text-gap"
                  >
                    1.
                  </span>
                  
              text.
            
                </td>
              </tr>
            </tbody>
          </table>
          

      
          <h3>
            Quotes
          </h3>
          
      
          <p>
            
        Short quotes can be defined using
        
            <code>
              blockquote
            </code>
            
        element.
      
          </p>
          
      
          <pre
            className="code"
          >
            &lt;blockquote&gt;
  &lt;p&gt;
    Consectetur quis ad fugiat ad. Do consequat sunt sit non commodo. Fugiat
    laborum Lorem sint laboris cupidatat ipsum eiusmod. Incididunt
    exercitation nostrud duis nulla deserunt consectetur aliquip aliquip
    cupidatat. In reprehenderit aliquip velit anim pariatur. Lorem cillum
    irure cupidatat veniam non incididunt enim commodo. Cillum pariatur
    tempor excepteur laboris tempor exercitation consequat laboris
    adipisicing duis proident proident amet.
  &lt;/p&gt;
  &lt;p&gt;—https://www.ylioppilastutkinto.fi&lt;/p&gt;
&lt;/blockquote&gt;
          </pre>
          
      
          <div
            className="example"
          >
            
        
            <blockquote>
              
          
              <p>
                
            Consectetur quis ad fugiat ad. Do consequat sunt sit non commodo. Fugiat laborum Lorem sint laboris cupidatat ipsum eiusmod.
            Incididunt exercitation nostrud duis nulla deserunt consectetur aliquip aliquip cupidatat. In reprehenderit aliquip velit anim pariatur.
            Lorem cillum irure cupidatat veniam non incididunt enim commodo. Cillum pariatur tempor excepteur laboris tempor exercitation
            consequat laboris adipisicing duis proident proident amet.
          
              </p>
              
          
              <p>
                —https://www.ylioppilastutkinto.fi
              </p>
              
        
            </blockquote>
            
      
          </div>
          

      
          <p>
            
        Contents can also be highlighted using
        
            <code>
              e-box
            </code>
            
        class.
      
          </p>
          
      
          <pre
            className="code"
          >
            &lt;div class="e-box"&gt;
  Lorem ipsum dolor sit amet, consectetur adipisicing elit. Libero
  repudiandae sequi sapiente cumque necessitatibus ex voluptates
  ullam eveniet consequuntur nulla suscipit laboriosam fugiat, soluta
  repellat dolor quibusdam incidunt tempora. Suscipit.
&lt;/div&gt;
          </pre>
          
      
          <div
            className="example"
          >
            
        
            <div
              className="e-box"
            >
              
          Lorem ipsum dolor sit amet, consectetur adipisicing elit. Libero
          repudiandae sequi sapiente cumque necessitatibus ex voluptates
          ullam eveniet consequuntur nulla suscipit laboriosam fugiat, soluta
          repellat dolor quibusdam incidunt tempora. Suscipit.
        
            </div>
            
      
          </div>
          

    
        </div>
        

    
        <div
          aria-description="Tähän kysymykseen ei ole vastattu"
          className="e-exam-question e-level-0 e-mrg-b-8 e-clearfix no-answer"
          id="24"
        >
          
      
          <h3
            className="exam-question-title"
          >
            <strong
              className="exam-question-title__display-number"
            >
              24. 
            </strong>
            Lists
             
          </h3>
          
      
          <div
            className="exam-question-instruction e-mrg-b-2"
            id="question-instruction-190"
          >
            There are helper classes for various ordered lists.
          </div>
          

      
          <pre
            className="code"
          >
            &lt;ol class="e-list-lower-alpha"&gt;
  &lt;li&gt;Eka&lt;/li&gt;
  &lt;li&gt;Toka&lt;/li&gt;
  &lt;li&gt;Kolmas&lt;/li&gt;
&lt;/ol&gt;
          </pre>
          
      
          <div
            className="example"
          >
            
        
            <ol
              className="e-list-lower-alpha"
            >
              
          
              <li>
                First
              </li>
              
          
              <li>
                Second
              </li>
              
          
              <li>
                Third
              </li>
              
        
            </ol>
            
      
          </div>
          

      
          <pre
            className="code"
          >
            &lt;ol class="e-list-upper-alpha"&gt;
  &lt;li&gt;Eka&lt;/li&gt;
  &lt;li&gt;Toka&lt;/li&gt;
  &lt;li&gt;Kolmas&lt;/li&gt;
&lt;/ol&gt;
          </pre>
          
      
          <div
            className="example"
          >
            
        
            <ol
              className="e-list-upper-alpha"
            >
              
          
              <li>
                First
              </li>
              
          
              <li>
                Second
              </li>
              
          
              <li>
                Third
              </li>
              
        
            </ol>
            
      
          </div>
          

      
          <pre
            className="code"
          >
            &lt;ol class="e-list-lower-roman"&gt;
  &lt;li&gt;Eka&lt;/li&gt;
  &lt;li&gt;Toka&lt;/li&gt;
  &lt;li&gt;Kolmas&lt;/li&gt;
&lt;/ol&gt;
          </pre>
          
      
          <div
            className="example"
          >
            
        
            <ol
              className="e-list-lower-roman"
            >
              
          
              <li>
                First
              </li>
              
          
              <li>
                Second
              </li>
              
          
              <li>
                Third
              </li>
              
        
            </ol>
            
      
          </div>
          

      
          <pre
            className="code"
          >
            &lt;ol class="e-list-upper-roman"&gt;
  &lt;li&gt;Eka&lt;/li&gt;
  &lt;li&gt;Toka&lt;/li&gt;
  &lt;li&gt;Kolmas&lt;/li&gt;
&lt;/ol&gt;
          </pre>
          
      
          <div
            className="example"
