  &lt;e:dropdown-answer-option score="2"&gt;Lorem&lt;/e:dropdown-answer-option&gt;
  &lt;e:dropdown-answer-option score="-1"&gt;Ipsum&lt;/e:dropdown-answer-option&gt;
