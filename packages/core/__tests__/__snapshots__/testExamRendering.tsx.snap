  <section
    aria-labelledby="section-title-1"
    className="e-section e-bg-color-off-white e-pad-6 e-grading-instruction-section"
  >
    
    
    <h2
      className="e-grading-instructions-section-title"
      data-annotation-anchor="section-title-1"
      id="section-title-1"
    >
      Osa 1:
       
      Exam structure
    </h2>
    
    
    <div
      className="e-grading-instructions-question e-mrg-b-8 e-clearfix"
      data-annotation-anchor="1"
      id="1"
    >
      <div
        className="anchor"
        id="question-nr-1"
      />
      <h3
        className="exam-question-title"
      >
        <strong
          className="exam-question-title__display-number"
        >
          1. 
        </strong>
        XML structure
         
        <span
          className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
        >
          0 p.
        </span>
      </h3>
      <div
        className="exam-question-instruction e-mrg-b-2"
        id="question-instruction-167"
      >
        Exam structure is described in XML. It can contain also (X)HTML elements.
      
      </div>
      <div
        className="e-grading-instructions-question e-mrg-l-8 e-mrg-y-4"
        data-annotation-anchor="1.1"
        id="1.1"
      >
        <div
          className="anchor"
          id="question-nr-1.1"
        />
        <h4
          className="exam-question-title e-normal e-font-size-m"
        >
          <strong
            className="exam-question-title__display-number exam-question-title__display-number--indented"
          >
            1.1 
          </strong>
          Special characters as entities
           
          <span
            className="e-score e-nowrap e-score--small e-font-size-m e-semibold"
          >
            0 p.
          </span>
        </h4>
        <div
          className="exam-question-instruction e-mrg-b-2"
          id="question-instruction-168"
        >
          
          
          <p>
            Certain characters requires escaping as entities in exam XML documents
          </p>
          
          
          <table
            className="e-table"
          >
            <caption />
            <thead>
              <tr>
                <th>
                  Character
                </th>
                <th>
                  Notation
                </th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  NBSP (non-breaking-space)
                </td>
                <td>
                  <code>
                    &#xA0;
                  </code>
                </td>
              </tr>
              <tr>
                <td>
                  SHY ­ (soft-hyphen)
                </td>
                <td>
                  <code>
                    &#173;
                  </code>
                </td>
              </tr>
              <tr>
                <td>
                  &gt;
                </td>
                <td>
                  <code>
                    &gt;
                  </code>
                </td>
              </tr>
              <tr>
                <td>
                  &lt;
                </td>
                <td>
                  <code>
                    &lt;
                  </code>
                </td>
              </tr>
              <tr>
                <td>
                  &
                </td>
                <td>
                  <code>
                    &amp;
                  </code>
                </td>
              </tr>
            </tbody>
          </table>
          
          
          <p>
            Notice, that e.g. 
            <code>
              &nbsp;
            </code>
             and 
            <code>
              &shy;
            </code>
             does not work.
          </p>
          
        
        </div>
      </div>
    </div>
    

    
    <div
      className="e-grading-instructions-question e-mrg-b-8 e-clearfix"
      data-annotation-anchor="2"
      id="2"
    >
      <div
        className="anchor"
        id="question-nr-2"
      />
      <h3
        className="exam-question-title"
      >
        <strong
          className="exam-question-title__display-number"
        >
          2. 
        </strong>
        Exam
         
        <span
          className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
        >
          0 p.
        </span>
      </h3>
      <div
        className="exam-question-instruction e-mrg-b-2"
        id="question-instruction-169"
      >
        
        
        <p>
          
          Top-level exam element.
        
        </p>
        
      
      </div>
      <div
        className="e-grading-instructions-question e-mrg-l-8 e-mrg-y-4"
        data-annotation-anchor="2.1"
        id="2.1"
      >
        <div
          className="anchor"
          id="question-nr-2.1"
        />
        <h4
          className="exam-question-title e-normal e-font-size-m"
        >
          <strong
            className="exam-question-title__display-number exam-question-title__display-number--indented"
          >
            2.1 
          </strong>
          Example
           
          <span
            className="e-score e-nowrap e-score--small e-font-size-m e-semibold"
          >
            0 p.
          </span>
        </h4>
      </div>
    </div>
    

    
    <div
      className="e-grading-instructions-question e-mrg-b-8 e-clearfix"
      data-annotation-anchor="3"
      id="3"
    >
      <div
        className="anchor"
        id="question-nr-3"
      />
      <h3
        className="exam-question-title"
      >
        <strong
          className="exam-question-title__display-number"
        >
          3. 
        </strong>
        Languages and localization
         
        <span
          className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
        >
          0 p.
        </span>
      </h3>
      <div
        className="exam-question-instruction e-mrg-b-2"
        id="question-instruction-170"
      >
        
        
        <p>
          
          Content for multiple language versions of the same exam can be defined using localization elements.
        
        </p>
        
        
        <div
          className="warning-box"
        >
          
          Multiple languages work in Abitti when you create transfer zip with "npm run create-transfer-zip" -command. It generates separate transfer zip for each language.
        
        </div>
        
      
      </div>
      <div
        className="e-grading-instructions-question e-mrg-l-8 e-mrg-y-4"
        data-annotation-anchor="3.1"
        id="3.1"
      >
        <div
          className="anchor"
