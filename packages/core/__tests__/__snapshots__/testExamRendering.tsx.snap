        <section
          aria-labelledby="section-title-1"
          className="e-section e-bg-color-off-white e-pad-6 exam-section"
        >
          
    
          <h2
            className="exam-section-title"
            data-annotation-anchor="section-title-1"
            data-toc-id="section-1"
            id="section-title-1"
          >
            Teil 1:
             
            Hörverständnis
          </h2>
          

    
          <div
            className="e-audio-test notification e-pad-2 e-mrg-b-4"
          >
            <p>
              <span
                lang="fi-FI"
              >
                Koe sisältää kuullunymmärtämisen tehtäviä.
              </span>
            </p>
            <div
              className="e-columns e-columns--center-v e-mrg-b-2"
            >
              <div
                className="e-column e-column--narrow"
              >
                <button
                  className="e-button"
                  disabled={false}
                  onClick={[Function]}
                >
                  <svg
                    aria-hidden="true"
                    className="svg-inline--fa fa-play e-mrg-r-1 fa-fw"
                    data-icon="play"
                    data-prefix="fas"
                    role="img"
                    viewBox="0 0 448 512"
                  >
                    <path
                      d="M91.2 36.9c-12.4-6.8-27.4-6.5-39.6 .7S32 57.9 32 72l0 368c0 14.1 7.5 27.2 19.6 34.4s27.2 7.5 39.6 .7l336-184c12.8-7 20.8-20.5 20.8-35.1s-8-28.1-20.8-35.1l-336-184z"
                      fill="currentColor"
                    />
                  </svg>
                  <span
                    lang="fi-FI"
                  >
                    Testaa äänitteiden kuuluvuus
                  </span>
                </button>
              </div>
              <div
                className="e-column"
              >
                <div
                  style={{}}
                >
                  <span
                    style={null}
                  >
                    <div>
                       
                    </div>
                  </span>
                </div>
              </div>
            </div>
            <div>
              <span
                lang="fi-FI"
              >
                Äänen voimakkuutta voit säätää ruudun oikeasta yläkulmasta.
              </span>
            </div>
          </div>
          

    
          <div
            className="e-exam-question e-level-0 e-pad-b-8 e-clearfix"
            data-annotation-anchor="1"
            data-toc-id="question-1"
          >
            <div
              className="anchor"
              id="question-nr-1"
            />
            
      
            <h3
              className="exam-question-title"
              id="question-title-1"
            >
              <strong
                className="exam-question-title__display-number"
              >
                1. 
              </strong>
              Picknick
               
              <span
                className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
              >
                <span
                  lang="fi-FI"
                >
                  21 p.
                </span>
              </span>
            </h3>
            
      
            <div
              className="exam-question-instruction e-mrg-b-2"
              id="question-instruction-320"
            >
              

        Paula, Alina, Kevin und Niklas sind in einer WhatsApp-Gruppe. Sie schicken sich
        Sprachnachrichten. Hören Sie die Diskussion und beantworten Sie die Fragen. Hören Sie zunächst den Text als
        Ganzes und dann in Abschnitten.
      
            </div>
            
      
            <div
              className="e-audio-group"
            >
              <div
                className="e-audio-group--separator e-font-size-xl e-mrg-y-4 e-color-link"
                role="separator"
              >
                ✲✲✲
              </div>
              
        
              <span
                className="exam-attachment e-mrg-b-2"
              >
                
          
                
          
                <div
                  className="audio e-columns e-columns--center-v e-pad-b-2 e-cursor-default"
                  onClick={[Function]}
                >
                  <div
                    className="restricted-audio-player e-column e-column--narrow e-columns e-columns--inline e-columns--center-v e-pad-1"
                    lang="fi-FI"
                  >
                    <button
                      aria-labelledby="audio-remaining-0 audio-label-349"
                      className="restricted-audio-player__play e-column e-column--narrow"
                      disabled={false}
                      onClick={[Function]}
                    >
                      <svg
                        aria-hidden="true"
                        className="svg-inline--fa fa-play fa-fw"
                        data-icon="play"
                        data-prefix="fas"
                        role="img"
                        viewBox="0 0 448 512"
                      >
                        <path
                          d="M91.2 36.9c-12.4-6.8-27.4-6.5-39.6 .7S32 57.9 32 72l0 368c0 14.1 7.5 27.2 19.6 34.4s27.2 7.5 39.6 .7l336-184c12.8-7 20.8-20.5 20.8-35.1s-8-28.1-20.8-35.1l-336-184z"
                          fill="currentColor"
                        />
                      </svg>
                    </button>
                    <span
                      className="restricted-audio-player__duration e-column e-text-right"
                      id="audio-remaining-0"
                    >
                      02:22
                    </span>
