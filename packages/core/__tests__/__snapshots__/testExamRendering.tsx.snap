                      name="5"
                      onChange={[Function]}
                      type="radio"
                      value="23"
                    />
                    <div
                      className="e-choice-answer-option e-column e-pointer"
                    >
                      Ipsum
                    </div>
                  </label>
                </div>
                <div
                  className="e-mrg-b-1"
                >
                  <label
                    className="e-columns e-columns--inline"
                  >
                    <input
