                <strong
                  className="exam-question-title__display-number exam-question-title__display-number--indented"
                >
                  1.1 
                </strong>
                
			
      
                <span
                  lang="sv-FI"
                >
                  
        Värdet av uttrycket 
                  <span
                    aria-hidden="true"
                    className="e-formula"
                    dangerouslySetInnerHTML={
                      {
