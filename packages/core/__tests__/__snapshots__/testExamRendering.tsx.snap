        >
          
    
          <h2
            className="exam-section-title"
            data-annotation-anchor="section-title-1"
            data-toc-id="section-1"
            id="section-title-1"
          >
            Osa 1:
             
            Exam structure
          </h2>
          
    
          <div
            className="e-exam-question e-level-0 e-pad-b-8 e-clearfix"
            data-annotation-anchor="1"
            data-toc-id="question-1"
          >
            <div
              className="anchor"
              id="question-nr-1"
            />
            
      
            <h3
              className="exam-question-title"
              id="question-title-1"
            >
              <strong
                className="exam-question-title__display-number"
              >
                1. 
              </strong>
              XML structure
               
              <span
                className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
              >
                0 p.
              </span>
            </h3>
            
      
            <div
              className="exam-question-instruction e-mrg-b-2"
              id="question-instruction-167"
            >
              Exam structure is described in XML. It can contain also (X)HTML elements.
      
            </div>
            
      
            <div
              className="tree"
            >
              
        
              <div>
                
          
                <strong>
                  
            Exam
            
                  <code>
                    &lt;e:exam&gt;
                  </code>
                  
          
                </strong>
                
          1 element
          
                <p>
                  
            Root element of the exam. All other elements are its descendants.
          
                </p>
                
          
                <div>
                  
            
                  <strong>
                    
              Exam languages
              
                    <code>
                      &lt;e:languages&gt;
                    </code>
                    
            
                  </strong>
                  
            1 element
            
                  <div>
                    
              
                    <strong>
                      
                Exam language
                
                      <code>
                        &lt;e:language&gt;
                      </code>
                      
              
                    </strong>
                    
              1-n elements
            
                  </div>
                  
          
                </div>
                
          
                <div>
                  
            
                  <strong>
                    
              Exam title
              
                    <code>
                      &lt;e:exam-title&gt;
                    </code>
                    
            
                  </strong>
                  
            1 element
          
                </div>
                
          
                <div>
                  
            
                  <strong>
                    
              Exam introduction and instructions
              
                    <code>
                      &lt;e:exam-instruction&gt;
                    </code>
                    
            
                  </strong>
                  
            1 element
          
                </div>
                
          
                <div>
                  
            
                  <strong>
                    
              Reference to exam introduction and instructions read from file
              
                    <code>
                      &lt;e:exam-instruction-ref&gt;
                    </code>
                    
            
                  </strong>
                  
            1 element
          
                </div>
                
          
                <div>
                  
            
                  <strong>
                    
              Table of contents
              
                    <code>
                      &lt;e:table-of-contents&gt;
                    </code>
                    
            
                  </strong>
                  
            1 element
          
                </div>
                
          
                <div>
                  
            
                  <strong>
                    
              Exam-specific external material
              
                    <code>
                      &lt;e:external-material&gt;
                    </code>
                    
            
                  </strong>
                  
            0-1 elements
            
                  <p>
                    
              External material page is constructed based on
              
                    <code>
                      e:external-material
                    </code>
                    
              elements
              defined within
              
                    <code>
                      e:exam
                    </code>
                    
              and
              
                    <code>
                      e:question
                    </code>
                    
              elements.
              Contains
              
                    <code>
                      e:attachment
                    </code>
                    
              elements.
            
                  </p>
                  
          
                </div>
                
          
                <div>
                  
            
                  <strong>
                    
              Section
              
                    <code>
                      &lt;e:section&gt;
                    </code>
                    
            
                  </strong>
                  
            1-n elements
            
                  <p>
                    Section groups questions
                  </p>
                  
            
                  <div>
                    
              
                    <strong>
                      
                Section title
                
                      <code>
                        &lt;e:section-title&gt;
                      </code>
                      
              
                    </strong>
                    
              1 element
              
                    <p>
                      Section title can contain HTML elements. Section number is added automatically.
                    </p>
                    
            
                  </div>
                  
            
                  <div>
                    
              
                    <strong>
                      
                Section instructions
                
                      <code>
                        &lt;e:section-instruction&gt;
                      </code>
                      
              
                    </strong>
                    
              0-n elements
              
                    <p>
                      Section instructions can contain HTML elements.
                    </p>
                    
            
                  </div>
                  
            
                  <div>
                    
              
                    <strong>
                      
                Question
                
                      <code>
                        &lt;e:question&gt;
                      </code>
                      
              
                    </strong>
                    
              0-n elements
              
                    <p>
                      
                Questions can contain sub-
                
                      <code>
                        e:question
                      </code>
                      
                s
              
                    </p>
                    
              
                    <div>
                      
                
                      <strong>
                        
                  Question title
                  
                        <code>
                          &lt;e:question-title&gt;
                        </code>
                        
                
                      </strong>
                      
                1 element
                
                      <p>
                        Question title can contain HTML elements. Question number is added automatically.
                      </p>
                      
              
                    </div>
                    
              
                    <div>
                      
                
                      <strong>
                        
                  Question instructions
                  
                        <code>
                          &lt;e:question-instruction&gt;
                        </code>
                        
                
                      </strong>
                      
                0-1 elements
                
                      <p>
                        Question instructions can contain HTML elements.
                      </p>
                      
              
                    </div>
                    
              
                    <div>
                      
                
                      <strong>
                        
                  Question-specific external material
                  
                        <code>
                          &lt;e:external-material&gt;
                        </code>
                        
                
                      </strong>
                      
                0-1 elements
                
                      <p>
                        
                  External material page is constructed based on
                  
                        <code>
                          e:external-material
                        </code>
                        
                  elements
                  defined within
                  
                        <code>
                          e:exam
                        </code>
                        
                  and
                  
                        <code>
                          e:question
                        </code>
                        
                  elements.
                  Contains
                  
                        <code>
                          e:attachment
                        </code>
                        
                  elements.
                
                      </p>
                      
              
                    </div>
                    
              
                    <div>
                      
                
                      <strong>
                        
                  Internal material
                  
                        <code>
                          &lt;e:attachment&gt;
                        </code>
                        
                
                      </strong>
                      
                0-n elements
                
                      <p>
                        
                  Internal material is displayed directly on exam page. Use
                  
                        <code>
                          e:external-material
                        </code>
                        
                  to
                  display material on separate external material page.
                
                      </p>
                      
                
                      <div>
                        
                  
                        <strong>
                          
                    Material title
                    
                          <code>
                            &lt;e:attachment-title&gt;
                          </code>
                          
                  
                        </strong>
                        
                  1 element
                
                      </div>
                      
                
                      <div>
                        
                  
                        <strong>
                          
                    Audio material
                    
                          <code>
                            &lt;e:audio&gt;
                          </code>
                          
                  
                        </strong>
                        
                  0-1 elements
                
                      </div>
                      
                
                      <div>
                        
                  
                        <strong>
                          
                    Image material
                    
                          <code>
                            &lt;e:image&gt;
                          </code>
                          
                  
                        </strong>
                        
                  0-1 elements
                
                      </div>
                      
                
                      <div>
                        
                  
                        <strong>
                          
                    Video material
                    
                          <code>
                            &lt;e:video&gt;
                          </code>
                          
                  
                        </strong>
                        
                  0-1 elements
                
                      </div>
                      
                
                      <div>
                        
                  
                        <strong>
                          
                    Material reference
                    
                          <code>
                            &lt;e:reference&gt;
                          </code>
                          
                  
                        </strong>
                        
                  1 element. See section Material below for details.
                
                      </div>
                      
              
                    </div>
                    
              
                    <div>
                      
                
                      <strong>
                        
                  Answer type, e.g.
                  
                        <code>
                          &lt;e:text-answer&gt;
                        </code>
                        
                
                      </strong>
                      
                0-n elements
                
                      <p>
                        See section Answer types below for details.
                      </p>
                      
              
                    </div>
                    
              
                    <div>
                      
                
                      <strong>
                        
                  Question number,
                  
                        <code>
                          &lt;e:question-number&gt;
                        </code>
                        
                
                      </strong>
                      
                0-n elements
                
                      <p>
                        To show parent question number as a prefix and fixed number as a suffix.
                      </p>
                      
              
                    </div>
                    
              
                    <div>
                      
                
                      <strong>
                        OR
                      </strong>
                      
              
                    </div>
                    
              
                    <div>
                      
                
                      <strong>
                        
                  Sub-question
                  
                        <code>
                          &lt;e:question&gt;
                        </code>
                        
                
                      </strong>
                      
                0-n elements
              
                    </div>
                    
            
                  </div>
                  
          
                </div>
                
          
                <div>
                  
            
                  <strong>
                    
              Material references
              
                    <code>
                      &lt;e:references&gt;
                    </code>
                    
            
                  </strong>
                  
            0-1 elements
          
                </div>
                
          
                <div>
                  
            
                  <strong>
                    
              Exam footer
              
                    <code>
                      &lt;e:exam-footer&gt;
                    </code>
                    
            
                  </strong>
                  
            0-1 elements
          
