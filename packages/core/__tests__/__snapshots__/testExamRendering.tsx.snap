        >
          
      
          <h3
            className="exam-question-title"
          >
            <strong
              className="exam-question-title__display-number"
            >
              8. 
            </strong>
            
        choice-answer
      
             
          </h3>
          
      
          <div
            className="exam-question-instruction e-mrg-b-2"
            id="question-instruction-176"
          >
            
        
            <p>
              
          
              <code>
                e:choice-answer
              </code>
              
          answer type creates a group of option buttons. Answer options are defined within it
          using
          
              <code>
                e:choice-answer-option
              </code>
              
          elements.
        
            </p>
            
        
            <p>
              By default options are shuffled.
            </p>
            
      
          </div>
          

      
          <table
            className="e-table e-width-full"
          >
            <caption>
              
          Element attributes (
          
              <code>
                e:choice-answer
              </code>
              
          )
        
            </caption>
            <thead>
              <tr>
                <th>
                  Attribute
                </th>
                <th>
                  Type
                </th>
                <th>
                  Mandatory
                </th>
                <th>
                  Default value
                </th>
                <th>
                  Description
                </th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  ordering
                </td>
                <td>
                  
              
                  <code>
                    random | fixed
                  </code>
                  
            
                </td>
                <td>
                  No
                </td>
                <td>
                  random
                </td>
                <td>
                  Ordering of options
                </td>
              </tr>
              <tr>
                <td>
                  direction
                </td>
                <td>
                  
              
                  <code>
                    vertical | horizontal
                  </code>
                  
            
                </td>
                <td>
                  No
                </td>
                <td>
                  vertical
                </td>
                <td>
                  Direction of options
                </td>
              </tr>
              <tr>
                <td>
                  class
                </td>
                <td>
                  CSS class
                </td>
                <td>
                  No
                </td>
                <td>
                  -
                </td>
                <td>
                  CSS class name
                </td>
              </tr>
              <tr>
                <td>
                  meta
                </td>
                <td>
                  String
                </td>
                <td>
                  No
                </td>
                <td>
                  –
                </td>
                <td>
                  Metadata about element
                </td>
              </tr>
            </tbody>
          </table>
          

      
          <table
            className="e-table e-width-full"
          >
            <caption>
              
          Element attributes (
          
              <code>
                e:choice-answer-option
              </code>
              
          )
        
            </caption>
            <thead>
              <tr>
                <th>
                  Attribute
                </th>
                <th>
                  Type
                </th>
                <th>
                  Mandatory
                </th>
                <th>
                  Default value
                </th>
                <th>
                  Description
                </th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  score
                </td>
                <td>
                  Integer
                </td>
                <td>
                  No
                </td>
                <td>
                  0
                </td>
                <td>
                  Score for option
                </td>
              </tr>
              <tr>
                <td>
                  class
                </td>
                <td>
                  CSS class
                </td>
                <td>
                  No
                </td>
                <td>
                  -
                </td>
                <td>
                  CSS class name
                </td>
              </tr>
              <tr>
                <td>
                  meta
                </td>
                <td>
                  String
                </td>
                <td>
                  No
                </td>
                <td>
                  –
                </td>
                <td>
                  Metadata about element
                </td>
              </tr>
            </tbody>
          </table>
          

      
          <h4>
            Examples
          </h4>
          
      
          <pre
            className="code"
          >
            &lt;e:choice-answer&gt;
  &lt;e:choice-answer-option score="2"&gt;Lorem&lt;/e:choice-answer-option&gt;
  &lt;e:choice-answer-option score="0"&gt;Ipsum&lt;/e:choice-answer-option&gt;
  &lt;e:choice-answer-option&gt;Dolor&lt;/e:choice-answer-option&gt;
  &lt;e:choice-answer-option score="-1"&gt;Sit&lt;/e:choice-answer-option&gt;
&lt;/e:choice-answer&gt;
          </pre>
          
      
          <div
            className="example"
          >
            
        
            <span
              className="e-result-scorecount e-float-right"
            >
              <span
                className="e-result-scorecount-border-wrap"
              >
                <b>
                  0
                </b>
                 
                / 2 
                 
                 p.
              </span>
            </span>
            <div
              className="e-choice-answer"
            >
              <div
                className="e-mrg-b-1"
              >
                <label
                  className="e-columns e-columns--inline"
                >
                  <input
                    checked={true}
                    className="e-radio-button e-column e-column--narrow"
                    name="5"
                    readOnly={true}
                    type="radio"
                    value="23"
                  />
                  <div
                    className="e-choice-answer-option e-column e-choice-answer-option--selected"
                  >
                    Ipsum
                  </div>
                </label>
              </div>
              <div
                className="e-mrg-b-1"
              >
                <label
                  className="e-columns e-columns--inline"
                >
                  <input
                    checked={false}
                    className="e-radio-button e-column e-column--narrow"
                    name="5"
