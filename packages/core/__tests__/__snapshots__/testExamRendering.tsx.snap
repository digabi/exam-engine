          <div
            className="e-exam-question e-level-0 e-pad-b-8 e-clearfix"
            data-annotation-anchor="27"
            data-toc-id="question-27"
          >
            <div
              className="anchor"
              id="question-nr-27"
            />
            
      
            <h3
              className="exam-question-title"
              id="question-title-27"
            >
              <strong
                className="exam-question-title__display-number"
              >
                27. 
              </strong>
              Margins and paddings
               
              <span
                className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
              >
                0 p.
              </span>
            </h3>
            
      
            <div
              className="exam-question-instruction e-mrg-b-2"
              id="question-instruction-192"
            >
              
        
              <p>
                
          For setting margin and padding there are own helper classes. The size set using
          numbers, e.g. in
          
                <code>
                  e-pad-8
                </code>
                
          the padding is 8 times larger than in
          
                <code>
                  e-pad-1
                </code>
                
          .
        
              </p>
              
        
              <p>
                You can use numbers 1 to 8.
              </p>
              
      
            </div>
            

      
            <table
              className="e-table e-width-full"
            >
              <thead>
                <tr>
                  <th>
                    Class
                  </th>
                  <th>
                    Description
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>
                    
              
                    <code>
                      e-pad-*
                    </code>
                    
            
                  </td>
                  <td>
                    
              Padding to
              
                    <strong>
                      every direction
                    </strong>
                    
            
                  </td>
                </tr>
                <tr>
                  <td>
                    
              
                    <code>
                      e-pad-l-*
                    </code>
                    
            
                  </td>
                  <td>
                    
              Padding to the
              
                    <strong>
                      left
                    </strong>
                    
            
                  </td>
                </tr>
                <tr>
                  <td>
                    
              
                    <code>
                      e-pad-r-*
                    </code>
                    
            
                  </td>
                  <td>
                    
              Padding to the
              
                    <strong>
                      right
                    </strong>
                    
            
                  </td>
                </tr>
                <tr>
                  <td>
                    
              
                    <code>
                      e-pad-l-*
                    </code>
                    
            
                  </td>
                  <td>
                    
              Padding to the
              
                    <strong>
                      top
                    </strong>
                    
            
                  </td>
                </tr>
                <tr>
                  <td>
                    
              
                    <code>
                      e-pad-b-*
                    </code>
                    
            
                  </td>
                  <td>
                    
              Padding to the
              
                    <strong>
                      bottom
                    </strong>
                    
            
                  </td>
                </tr>
                <tr>
                  <td>
                    
              
                    <code>
                      e-pad-x-*
                    </code>
                    
            
                  </td>
                  <td>
                    
              Padding to the
              
                    <strong>
                      left and right
                    </strong>
                    
            
                  </td>
                </tr>
                <tr>
                  <td>
                    
              
                    <code>
                      e-pad-y-*
                    </code>
                    
            
                  </td>
                  <td>
                    
              Padding to the
              
                    <strong>
                      top and bottom
                    </strong>
                    
            
                  </td>
                </tr>
                <tr>
                  <td>
                    
              
                    <code>
                      e-mrg-*
                    </code>
                    
            
                  </td>
                  <td>
                    
              Margin to
              
                    <strong>
                      every direction
                    </strong>
                    
            
                  </td>
                </tr>
                <tr>
                  <td>
                    
              
                    <code>
                      e-mrg-l-*
                    </code>
                    
            
                  </td>
                  <td>
                    
              Margin to the
              
                    <strong>
                      left
                    </strong>
                    
            
                  </td>
                </tr>
                <tr>
                  <td>
                    
              
                    <code>
                      e-mrg-r-*
                    </code>
                    
            
                  </td>
                  <td>
                    
              Margin to the
              
                    <strong>
                      right
                    </strong>
                    
            
                  </td>
                </tr>
                <tr>
                  <td>
                    
              
                    <code>
                      e-mrg-t-*
                    </code>
                    
            
                  </td>
                  <td>
                    
              Margin to the
              
                    <strong>
                      top
                    </strong>
                    
            
                  </td>
                </tr>
                <tr>
                  <td>
                    
              
                    <code>
                      e-mrg-b-*
                    </code>
                    
            
                  </td>
                  <td>
                    
              Margin to the
              
                    <strong>
                      bottom
                    </strong>
                    
            
                  </td>
                </tr>
                <tr>
                  <td>
                    
              
                    <code>
                      e-mrg-x-*
                    </code>
                    
            
                  </td>
                  <td>
                    
              Margin to the
              
                    <strong>
                      left and right
                    </strong>
                    
            
                  </td>
                </tr>
                <tr>
                  <td>
                    
              
                    <code>
                      e-mrg-y-*
                    </code>
                    
            
                  </td>
                  <td>
                    
              Margin to the
              
                    <strong>
                      top and bottom
                    </strong>
                    
            
                  </td>
                </tr>
              </tbody>
            </table>
            

      
            <pre
              className="code"
            >
              &lt;div&gt;
  &lt;span class="e-pad-1"&gt;e-pad-1&lt;/span&gt;
  &lt;span class="e-pad-2"&gt;e-pad-2&lt;/span&gt;
  &lt;span class="e-pad-4"&gt;e-pad-4&lt;/span&gt;
  &lt;span class="e-pad-8"&gt;e-pad-8&lt;/span&gt;
&lt;/div&gt;
&lt;div&gt;
  &lt;span class="e-pad-l-1"&gt;e-pad-l-1&lt;/span&gt;
  &lt;span class="e-pad-l-2"&gt;e-pad-l-2&lt;/span&gt;
  &lt;span class="e-pad-l-4"&gt;e-pad-l-4&lt;/span&gt;
  &lt;span class="e-pad-l-8"&gt;e-pad-l-8&lt;/span&gt;
&lt;/div&gt;
&lt;div&gt;
  &lt;span class="e-pad-r-1"&gt;e-pad-r-1&lt;/span&gt;
  &lt;span class="e-pad-r-2"&gt;e-pad-r-2&lt;/span&gt;
  &lt;span class="e-pad-r-4"&gt;e-pad-r-4&lt;/span&gt;
  &lt;span class="e-pad-r-8"&gt;e-pad-r-8&lt;/span&gt;
&lt;/div&gt;
&lt;div&gt;
  &lt;span class="e-pad-x-1"&gt;e-pad-x-1&lt;/span&gt;
  &lt;span class="e-pad-x-2"&gt;e-pad-x-2&lt;/span&gt;
  &lt;span class="e-pad-x-4"&gt;e-pad-x-4&lt;/span&gt;
  &lt;span class="e-pad-x-8"&gt;e-pad-x-8&lt;/span&gt;
&lt;/div&gt;
&lt;div&gt;
  &lt;span class="e-pad-y-1"&gt;e-pad-y-1&lt;/span&gt;
  &lt;span class="e-pad-y-2"&gt;e-pad-y-2&lt;/span&gt;
  &lt;span class="e-pad-y-4"&gt;e-pad-y-4&lt;/span&gt;
  &lt;span class="e-pad-y-8"&gt;e-pad-y-8&lt;/span&gt;
&lt;/div&gt;
            </pre>
            
      
            <div
              className="example spacing-example"
            >
              
        
              <div>
                
          
                <span
                  className="e-pad-1"
                >
                  e-pad-1
                </span>
                
          
