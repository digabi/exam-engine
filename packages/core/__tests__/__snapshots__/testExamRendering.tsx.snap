                2 p.
              </span>
            </h3>
            
      
            <div
              className="exam-question-instruction e-mrg-b-2"
              id="question-instruction-177"
            >
              
        
              <p>
                
          
                <code>
                  e:dropdown-answer
                </code>
                
          creates a dropdown menu.
        Similarly to
          
                <code>
                  e:choice-answer
                </code>
                
          , answer options are defined within it using
          
                <code>
                  e:dropdown-anser-option
                </code>
                
          elements.
        
              </p>
              
      
            </div>
            

      
            <table
              className="e-table e-width-full"
            >
              <caption>
                
          Element attributes (
          
                <code>
                  e:dropdown-answer
                </code>
                
          )
        
              </caption>
              <thead>
                <tr>
                  <th>
                    Attribute
                  </th>
                  <th>
                    Type
                  </th>
                  <th>
                    Mandatory
                  </th>
                  <th>
                    Default value
                  </th>
                  <th>
                    Description
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>
                    ordering
                  </td>
                  <td>
                    
              
                    <code>
                      random | fixed
                    </code>
                    
            
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    random
                  </td>
                  <td>
                    Ordering of options
                  </td>
                </tr>
                <tr>
                  <td>
                    class
                  </td>
                  <td>
                    CSS class
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    -
                  </td>
                  <td>
                    CSS class name
                  </td>
                </tr>
                <tr>
                  <td>
                    meta
                  </td>
                  <td>
                    String
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    –
                  </td>
                  <td>
                    Metadata about element
                  </td>
                </tr>
              </tbody>
            </table>
            

      
