            <h3
              className="exam-question-title"
              id="question-title-18"
            >
              <strong
                className="exam-question-title__display-number"
              >
                18. 
              </strong>
              video
               
              <span
                className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
              >
                0 p.
              </span>
            </h3>
            
      
            <div
              className="exam-question-instruction e-mrg-b-2"
              id="question-instruction-185"
            >
              
        
              <code>
                e:video
              </code>
              
        element adds an video to the exam. It can be used anywhere where
          HTML is allowed.
      
            </div>
            

      
            <table
              className="e-table e-width-full"
            >
              <caption>
                Element attributes
              </caption>
              <thead>
                <tr>
                  <th>
                    Attribute
                  </th>
                  <th>
                    Type
                  </th>
                  <th>
                    Mandatory
                  </th>
                  <th>
                    Default value
                  </th>
                  <th>
                    Description
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>
                    src
                  </td>
                  <td>
                    String
                  </td>
                  <td>
                    Yes
                  </td>
                  <td>
                    –
                  </td>
                  <td>
                    Video file name
                  </td>
                </tr>
                <tr>
                  <td>
                    lang
                  </td>
                  <td>
                    String
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    –
                  </td>
                  <td>
                    Exam language code. Use when video should be included only in certain language version.
            
                  </td>
                </tr>
                <tr>
                  <td>
                    class
                  </td>
                  <td>
                    CSS class
                  </td>
                  <td>
                    No
                  </td>
                  <td>
                    -
                  </td>
                  <td>
                    CSS class name
                  </td>
                </tr>
              </tbody>
            </table>
            

      
            <h4>
              Example
            </h4>
            
      
            <pre
              className="code"
            >
              &lt;e:video src="example1.webm" /&gt;
            </pre>
            
      
            <div
              className="example"
            >
              
        
              <span
                className="responsive-media-container"
                style={
                  {
                    "maxWidth": 640,
                  }
                }
              >
                <span
                  className="responsive-media-container__inner"
                  style={
                    {
                      "paddingBottom": "56.25%",
                    }
                  }
                >
                  <video
                    className="video"
                    controls={true}
                    controlsList="nodownload"
                    disablePictureInPicture={true}
                    preload="metadata"
                  >
                    <source
                      src="/attachments/example1.webm"
                    />
                  </video>
                </span>
              </span>
              
      
            </div>
            
    
          </div>
          

    
          <div
