        <section
          aria-labelledby="section-title-1"
          className="e-section e-bg-color-off-white e-pad-6 exam-section"
        >
          
    
          <h2
            className="exam-section-title"
            data-annotation-anchor="section-title-1"
            data-toc-id="section-1"
            id="section-title-1"
          >
            Del 1:
             
            
      
      
            <span
              lang="sv-FI"
            >
              
        20-poängsuppgift
      
            </span>
            
    
          </h2>
          <span
            className="notification notification--inline"
          >
            <svg
              aria-hidden="true"
              className="svg-inline--fa fa-circle-info e-color-link e-mrg-r-1 fa-fw fa-lg"
              data-icon="circle-info"
              data-prefix="fas"
              role="img"
              viewBox="0 0 512 512"
            >
              <path
                d="M256 512a256 256 0 1 0 0-512 256 256 0 1 0 0 512zM224 160a32 32 0 1 1 64 0 32 32 0 1 1 -64 0zm-8 64l48 0c13.3 0 24 10.7 24 24l0 88 8 0c13.3 0 24 10.7 24 24s-10.7 24-24 24l-80 0c-13.3 0-24-10.7-24-24s10.7-24 24-24l24 0 0-64-24 0c-13.3 0-24-10.7-24-24s10.7-24 24-24z"
                fill="currentColor"
              />
            </svg>
            Besvara uppgift 1.
          </span>
          

    
    
          <div
            className="e-exam-question e-level-0 e-pad-b-8 e-clearfix"
            data-annotation-anchor="1"
            data-toc-id="question-1"
          >
            <div
              className="anchor"
              id="question-nr-1"
            />
            
      
            <h3
              className="exam-question-title"
              id="question-title-1"
            >
              <strong
                className="exam-question-title__display-number"
              >
                1. 
              </strong>
              
        
        
              <span
                lang="sv-FI"
              >
                
          Påståenden om olika delområden inom geografin
        
              </span>
              
      
               
              <span
                className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
              >
                20 p.
              </span>
            </h3>
            
      
            <div
              className="exam-question-instruction e-mrg-b-2"
              id="question-instruction-131"
            >
              
        
        
              <span
                lang="sv-FI"
              >
                
          Välj för respektive moment 1.1.–1.10. det påstående som är
          
                <b>
                  falskt
                </b>
                
          . I varje uppgiftsmoment finns endast ett påstående som är falskt. För rätt alternativ får du två poäng, väljer du fel alternativ dras en poäng av. Om du väljer att inte svara ges noll poäng.
        
              </span>
              
      
            </div>
            
      
            <div
              className="e-exam-question e-mrg-l-8 e-mrg-y-4"
              data-annotation-anchor="1.1"
              data-toc-id="question-1.1"
            >
              <div
                className="anchor"
                id="question-nr-1.1"
              />
              
        
              <h4
                className="exam-question-title e-normal e-font-size-m"
                id="question-title-1.1"
              >
                <strong
                  className="exam-question-title__display-number exam-question-title__display-number--indented"
                >
                  1.1 
                </strong>
                
          
          
                <span
                  lang="sv-FI"
                >
                  
            Erosion
          
                </span>
                
        
                 
                <span
                  className="e-score e-nowrap e-score--small e-font-size-m e-semibold"
                >
                  2 p.
                </span>
              </h4>
              
        
        
              <span
                lang="sv-FI"
              >
                
          
                <div
                  aria-labelledby="question-title-1.1"
                  className="e-choice-answer e-mrg-b-4"
                  data-question-id={2}
                  role="radiogroup"
                >
                  <span
                    className="anchor"
                    id="question-nr-1.1"
                  />
                  <div
                    className="e-mrg-b-1"
                  >
                    <label
                      className="e-columns e-columns--inline"
                    >
                      <input
                        checked={false}
                        className="e-radio-button e-column e-column--narrow"
                        name="2"
                        onChange={[Function]}
                        type="radio"
                        value="47"
                      />
                      <div
                        className="e-choice-answer-option e-column e-pointer"
                      >
                        Flödande vatten är den mest betydande erosionskraften på jorden.
                      </div>
                    </label>
                  </div>
                  <div
                    className="e-mrg-b-1"
                  >
                    <label
                      className="e-columns e-columns--inline"
                    >
                      <input
                        checked={false}
                        className="e-radio-button e-column e-column--narrow"
                        name="2"
                        onChange={[Function]}
                        type="radio"
                        value="48"
                      />
                      <div
                        className="e-choice-answer-option e-column e-pointer"
                      >
                        Som en konsekvens av klimatförändringen blir extrema väderfenomen vanligare och erosionen kraftigare.
                      </div>
                    </label>
                  </div>
                  <div
                    className="e-mrg-b-1"
                  >
                    <label
                      className="e-columns e-columns--inline"
                    >
                      <input
                        checked={false}
                        className="e-radio-button e-column e-column--narrow"
                        name="2"
                        onChange={[Function]}
                        type="radio"
                        value="49"
                      />
                      <div
                        className="e-choice-answer-option e-column e-pointer"
                      >
                        I de allra torraste områdena förekommer knappt någon erosion överhuvudtaget.
                      </div>
                    </label>
                  </div>
                  <div
                    className="e-mrg-b-1"
                  >
                    <label
                      className="e-columns e-columns--inline"
                    >
                      <input
                        checked={false}
                        className="e-radio-button e-column e-column--narrow"
                        name="2"
                        onChange={[Function]}
                        type="radio"
                        value="50"
                      />
                      <div
                        className="e-choice-answer-option e-column e-pointer"
                      >
                         Människans agerande har lett till kraftigare erosion på jorden.
                      </div>
                    </label>
                  </div>
                  <div
                    className="e-mrg-b-1"
                  >
                    <label
                      className="e-columns e-columns--inline"
                    >
                      <input
                        checked={false}
                        className="e-radio-button e-column e-column--narrow"
                        name="2"
                        onChange={[Function]}
                        type="radio"
                        value=""
                      />
                      <div
                        className="e-choice-answer-option e-column e-pointer"
                      >
                        Jag svarar inte.
                      </div>
                    </label>
                  </div>
                </div>
                
        
              </span>
              
      
            </div>
            
      
            <div
              className="e-exam-question e-mrg-l-8 e-mrg-y-4"
