</g>
</g>
</g>
</svg>",
                }
              }
            />
            <span
              className="e-screen-reader-only"
            >
              \\int_0^\\infty e^{-x^2} dx=\\frac{\\sqrt{\\pi}}{2}
            </span>
            
      
          </p>
          

      
          <h4>
            
        Example of a
        
            <code>
              assistive-title
            </code>
            
      
          </h4>
          
      
          <pre
            className="code"
          >
            &lt;e:formula assistive-title="10/36 &gt; 9/36 =1/4"&gt;\\frac{10}{36}&gt;\\frac{9}{36}=\\frac{1}{4}&lt;/e:formula&gt;
          </pre>
          
      
          <p>
            
        
            <span
              aria-hidden="true"
