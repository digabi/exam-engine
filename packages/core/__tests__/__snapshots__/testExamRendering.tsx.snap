</g>
</svg>",
                    }
                  }
                />
                <span
                  className="e-screen-reader-only"
                >
                  t
                </span>
                 så att datumet 7.9.2020 motsvarar värdet 
                <span
                  aria-hidden="true"
                  className="e-formula"
                  dangerouslySetInnerHTML={
                    {
                      "__html": "<svg xmlns:xlink="http://www.w3.org/1999/xlink" width="5.747ex" height="1.898ex" style="vertical-align: -0.227ex;" viewBox="0 -719.6 2474.6 817.3" role="img" focusable="false" xmlns="http://www.w3.org/2000/svg" aria-labelledby="MathJax-SVG-1-Title">
