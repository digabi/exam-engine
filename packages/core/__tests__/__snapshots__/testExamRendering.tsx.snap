  <section
    aria-labelledby="section-title-7"
    className="e-section e-bg-color-off-white e-pad-6 e-grading-instruction-section"
  >
    
    
    <h2
      className="e-grading-instructions-section-title"
      data-annotation-anchor="section-title-7"
      id="section-title-7"
    >
      Osa 7:
       
      Formulas
    </h2>
    
    
    <div
      className="e-grading-instructions-question e-mrg-b-8 e-clearfix"
      data-annotation-anchor="22"
      id="22"
    >
      <div
        className="anchor"
        id="question-nr-22"
      />
      <h3
        className="exam-question-title"
      >
        <strong
          className="exam-question-title__display-number"
        >
          22. 
        </strong>
        Adding formulas
         
        <span
          className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
        >
          0 p.
        </span>
      </h3>
      <div
        className="exam-question-instruction e-mrg-b-2"
        id="question-instruction-189"
      >
        
        
        <p>
          
          You can add
          
          <span
            aria-hidden="true"
            className="e-formula"
            dangerouslySetInnerHTML={
              {
                "__html": "<svg xmlns:xlink="http://www.w3.org/1999/xlink" width="6.461ex" height="2.454ex" style="vertical-align: -0.671ex;" viewBox="0 -767.4 2781.7 1056.5" role="img" focusable="false" xmlns="http://www.w3.org/2000/svg" aria-labelledby="MathJax-SVG-1-Title">
