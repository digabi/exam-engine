  <section
    aria-labelledby="section-title-3"
    className="e-section e-bg-color-off-white e-pad-6 e-grading-instruction-section"
  >
    
  
    <h2
      className="e-grading-instructions-section-title"
      data-annotation-anchor="section-title-3"
      id="section-title-3"
    >
       
      

    
      <span
        lang="fi-FI"
      >
        
        B2-osa
      
      </span>
      
      
  
    </h2>
    

 
    
    <div
      className="e-grading-instructions-question e-mrg-b-8 e-clearfix"
      data-annotation-anchor="10"
      id="10"
    >
      <div
        className="anchor"
        id="question-nr-10"
      />
      <h3
        className="exam-question-title"
      >
        <strong
          className="exam-question-title__display-number"
        >
          10. 
        </strong>
        
        
        <span
          lang="fi-FI"
        >
          Lukujono
        </span>
        
        
      
         
        <span
          className="e-score e-nowrap e-score--large e-font-size-l e-semibold"
        >
          <span
            lang="fi-FI"
          >
            12 p.
          </span>
        </span>
      </h3>
      <div
        className="exam-question-instruction e-mrg-b-2"
        id="question-instruction-296"
      >
        
        
        <span
          lang="fi-FI"
        >
          
          
          <p>
            Lukujono alkaa luvuilla 4 ja 9. Kuinka moni lukujonon jäsen on pienempi kuin 
            <span
              lang="fi-FI"
            >
              1000,
            </span>
             jos lukujono on
          </p>
          
          
          <ol>
            
            
            <li>
              <p>
                
            aritmeettinen 
                <b>
                  (6 p.)
                </b>
                
            
              </p>
            </li>
            
            
            <li>
              <p>
                
            geometrinen? 
                <b>
