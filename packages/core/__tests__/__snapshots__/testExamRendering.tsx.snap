</g>
</svg>",
                    }
                  }
                />
                <span
                  className="e-screen-reader-only"
                >
                  f(x)
                </span>
                 som ger en modell av försäljningsintäkterna då 
                <span
                  aria-hidden="true"
                  className="e-formula"
                  dangerouslySetInnerHTML={
                    {
                      "__html": "<svg xmlns:xlink="http://www.w3.org/1999/xlink" width="1.33ex" height="1.454ex" style="vertical-align: -0.227ex;" viewBox="0 -528.2 572.5 625.9" role="img" focusable="false" xmlns="http://www.w3.org/2000/svg" aria-labelledby="MathJax-SVG-1-Title">
