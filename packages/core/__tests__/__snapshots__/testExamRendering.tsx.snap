                <span>
                  . 
                </span>
                Free text field
              </span>
            </li>
          </ol>
        </section>
        
  
        <div
          className="e-exam-footer"
        >
          
    
          <p>
            
      For more information about using this format, see
      
            <a
              href="https://github.com/digabi/exam-engine"
            >
              https://github.com/digabi/exam-engine
            </a>
            
    
          </p>
          
    
          <p>
            
      
            <a
              href="https://abitti.net/abitti-trademark.html"
            >
              Use of Abitti Trademark policy
            </a>
            
    
          </p>
          
  
        </div>
        

        <div
          className="e-examine-exam"
        >
          <button
            aria-describedby="examineExamInstructions"
            className="e-button goto-examine-answers"
            onClick={[Function]}
          >
            Siirry tarkastelemaan vastauksiasi
          </button>
          <div
            className="e-examine-exam-instructions"
            id="examineExamInstructions"
          >
            Tarkastelun jälkeen voit vielä palata muokkaamaan vastauksia, tai päättää kokeen.
          </div>
        </div>
      </div>
    </div>
  </div>
  <footer
    className="e-footer"
