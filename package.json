{
  "name": "@digabi/exam-engine-root",
  "version": "1.0.7",
  "private": true,
  "repository": "https://github.com/digabi/exam-engine",
  "author": "Matriculation Examination Board, Finland",
  "license": "EUPL-1.1",
  "devDependencies": {
    "@digabi/eslint-config": "^3.0.0",
    "@playwright/experimental-ct-react": "^1.62.1",
    "@playwright/test": "^1.53.0",
    "@swc-node/jest": "^1.1.1",
    "@swc/helpers": "^0.5.2",
    "@types/cloneable-readable": "^2.0.0",
    "@types/fontfaceobserver": "^2.1.0",
    "@types/jest": "^30.0.0",
    "@types/less": "^3.0.8",
    "@types/lodash": "^4.14.149",
    "@types/lodash-es": "^4.17.3",
    "@types/node": "^24.10.9",
    "@types/react": "^18.2.21",
    "@types/react-css-transition-replace": "^2.1.3",
    "@types/react-dom": "^18.0.1",
    "@types/react-redux": "^7.1.5",
    "@types/yargs": "^17.0.0",
    "@types/yauzl-promise": "^4.0.0",
    "@types/yazl": "^3.3.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-promise": "^7.0.0",
    "eslint-plugin-react": "^7.37.0",
    "fast-check": "^4.9.0",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.0",
    "jest-junit": "^17.0.0",
    "jest-snapshot-serializer-raw": "^1.1.0",
    "lerna": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.2",
    "yauzl-promise": "^4.0.0"
  },
  "scripts": {
    "start": "node packages/cli/dist/start.js",
    "build": "tsc --build && npm run --workspace @digabi/exam-engine-core build",
    "watch": "tsc --build --watch",
    "lerna": "lerna",
    "lint": "prettier packages/core/src/**/*.less --check && eslint .",
    "ee": "node packages/cli/dist/index.js",
    "test": "npm run test-ct -- --project=chrome && npm run test-jest",
    "prepare": "tsc --build --force && npm run --workspace @digabi/exam-engine-core build",
    "test-jest": "I18NEXT_NO_SUPPORT_NOTICE=1 jest --runInBand",
    "test-ct": "playwright test -c packages/core/playwright-ct.config.ts",
    "clear-ct-cache": "rm -rf packages/core/__tests__/playwright/template/.cache"
  },
  "workspaces": [
    "packages/**"
  ],
  "allowScripts": {
    "libxmljs2@0.37.0": true,
    "@ffprobe-installer/linux-x64@5.2.0": true,
    "puppeteer@25.2.1": true
  }
}
